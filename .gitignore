# Entrega original de Dirección: se publica verificada en /docs, no se versiona el origen.
_docs_origen/

node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Expo / EAS
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab

# Entorno y secretos: nunca en el repositorio (08 §32)
.env
.env.*
!.env.example
# Hojas de credenciales ya resueltas para operar (capturas, demo): se derivan de .env.cuentas-demo y viven fuera del repo.
credenciales*.txt
# Credenciales de firma de Android bajadas de EAS (`eas credentials` → credentials.json + credentials/android/keystore.jks)
# y cualquier keystore o propiedades de firma de un build local: nunca en el repositorio.
credentials.json
credentials/
*.jks
*.keystore
keystore.properties

.DS_Store
Thumbs.db
*.log

# Evidencia de paquetes: los logs de CI se versionan.
!EVIDENCIA/**/*.log

# Documento de la escuela: no se versiona (docs/fuente_escolar/LEEME.md).
docs/fuente_escolar/*.pdf

# Configuración local de herramientas (rutas de esta máquina).
.claude/
apps/web/next-env.d.ts
