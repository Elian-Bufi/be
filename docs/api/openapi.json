{
  "openapi": "3.1.0",
  "info": {
    "title": "BE API — WP-02 Identidad y sesiones",
    "version": "0.2.0",
    "description": "Generado desde @be/domain (contratos.ts). No editar a mano."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "sesion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Sesión revocable verificada en cada request (08 §26)."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/registrations": {
      "post": {
        "operationId": "API-ACC-01",
        "summary": "Registrar identidad BE y perfil propio con A1 (términos) y A2 (privacidad) como actos separados. No concede A3.",
        "description": "Fuente: 09v8:227-307. AuthN: PUBLIC.",
        "security": [],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          },
          {
            "name": "X-BE-Surface",
            "in": "header",
            "required": false,
            "description": "Superficie declarada (procedencia). Nunca autoriza (DEUDA_LEGAJO DL-022).",
            "schema": {
              "type": "string",
              "enum": [
                "WEB",
                "APK"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "registrationIntent": {
                    "type": "string",
                    "enum": [
                      "ADVISEE",
                      "PROFESSIONAL"
                    ]
                  },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "localIdentifier": {
                        "type": "string"
                      },
                      "localCredential": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "localIdentifier",
                      "localCredential"
                    ],
                    "additionalProperties": false
                  },
                  "profile": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  },
                  "termsAcceptance": {
                    "type": "object",
                    "properties": {
                      "versionId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "versionId"
                    ],
                    "additionalProperties": false
                  },
                  "privacyAcknowledgement": {
                    "type": "object",
                    "properties": {
                      "versionId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "versionId"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "registrationIntent",
                  "identity",
                  "termsAcceptance",
                  "privacyAcknowledgement"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "identityId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "registrationIntent": {
                          "type": "string",
                          "enum": [
                            "ADVISEE",
                            "PROFESSIONAL"
                          ]
                        },
                        "accountOperationalState": {
                          "type": "string",
                          "enum": [
                            "OPERATIVA",
                            "SUSPENDIDA",
                            "CERRADA"
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        }
                      },
                      "required": [
                        "identityId",
                        "registrationIntent",
                        "accountOperationalState",
                        "createdAt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "ErrorEnvelope: INVALID_REQUEST | UNKNOWN_FIELD",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "ErrorEnvelope: REGISTRATION_NOT_AVAILABLE | IDEMPOTENCY_KEY_REUSED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "ErrorEnvelope: TERMS_VERSION_NOT_ACCEPTABLE | PRIVACY_VERSION_NOT_ACCEPTABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "ErrorEnvelope: RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "ErrorEnvelope: INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "ErrorEnvelope: DB_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
