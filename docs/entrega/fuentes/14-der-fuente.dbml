  ambito AmbitoDeEleccionDeGraficos [not null, note: 'Quién pidió: la cuenta autenticada o «PUBLICO».']
  plan_de_entrenamiento_id uuid [note: 'El plan de entrenamiento.']
  plan_nutricional_id uuid [note: 'El plan nutricional.']
  conjunto_id uuid [not null, note: 'El conjunto de gráficos.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (profesional_id, asesorado_id)
    conjunto_id
  }

  Note: 'El enfoque que el profesional eligió para una persona o para uno de sus planes con ella. Queda hasta que se cambie.'
}

// ─── Novedades y avisos ───────────────────────────────────────────────────────────────────────────

Table novedad [headercolor: #4F6B3A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  destinatario_id uuid [not null, note: 'Quién la recibe.']
  tipo TipoDeNovedad [not null, note: 'Qué pasó (plan nuevo, revisión, pedido, vínculo, entre otros).']
  alcance Alcance [note: 'El área, si corresponde.']
  fuente_id uuid [note: 'Quién la originó, si fue una cuenta.']
  referencia_tipo text [note: 'Tipo del recurso del hecho.']
  referencia_id uuid [note: 'Identificador del recurso del hecho.']
  fecha_local date [note: 'El día, según la zona horaria de la persona.']
  clave_de_unicidad text [not null, unique, note: 'Evita que el mismo hecho genere dos novedades.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (destinatario_id, momento_de_registro, id)
  }

  Note: 'Una novedad para una persona o un profesional: un hecho que le interesa, sin datos clínicos.'
}

Table lectura_de_novedad [headercolor: #4F6B3A] {
  novedad_id uuid [pk, note: 'La novedad.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La primera vez que alguien abrió una novedad.'
}

Table suscripcion_push [headercolor: #4F6B3A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  dispositivo_id uuid [not null, note: 'Identificador que genera la app al instalarse; no identifica al teléfono fuera de BE.']
  token text [not null, note: 'Token de Expo Push del teléfono; nunca se registra en los logs.']
  plataforma PlataformaDeAviso [not null, note: 'Plataforma del teléfono.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_alta timestamptz(3) [not null, default: `now()`, note: 'Cuándo se suscribió.']
  momento_de_baja timestamptz(3) [note: 'Cuándo se dio de baja, si se dio.']
  motivo_de_baja MotivoDeBajaDeSuscripcion [note: 'Por qué se dio de baja.']

  indexes {
    identidad_id
  }

  Note: 'Un teléfono que recibe los avisos de una cuenta, con su token.'
}

Table aviso_push [headercolor: #4F6B3A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  novedad_id uuid [not null, note: 'La novedad.']
  suscripcion_id uuid [not null, note: 'El teléfono suscrito.']
  estado EstadoDeAvisoPush [not null, note: 'En curso, enviado, rechazado, sin respuesta o agrupado con otro.']
  ticket text [note: 'El ticket de Expo, si lo aceptó.']
  detalle text [note: 'El código del rechazo o la falla; nunca el token.']
  intentos integer [not null, default: 1, note: 'Cuántas veces se intentó.']
  momento_de_intento timestamptz(3) [not null, note: 'Cuándo se intentó por última vez.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (novedad_id, suscripcion_id) [unique]
    (estado, momento_de_intento)
  }

  Note: 'Cada aviso enviado a un teléfono, con su estado e intentos. Dice solo cuántas novedades o recordatorios hay, sin datos de salud.'
}

Table preferencia_de_recordatorio [headercolor: #4F6B3A] {
  identidad_id uuid [note: 'La cuenta.']
  tipo TipoDeRecordatorio [note: 'Qué recordatorio (comidas o entrenamiento).']
  estado EstadoDePreferencia [not null, note: 'Activa o inactiva. Sin fila, inactiva.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (identidad_id, tipo) [pk]
  }

  Note: 'Si la persona quiere los recordatorios diarios de registro, por tipo.'
}

