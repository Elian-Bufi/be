// BE · Diagrama entidad-relación · fuente en DBML
// Generado desde prisma/schema.prisma, el archivo con el que se crean las migraciones. No se edita a mano:
// si el esquema cambia, se vuelve a generar. Para verlo: https://dbdiagram.io/d → pegar este texto (o Import → DBML).

Project BE {
  database_type: 'PostgreSQL'
  Note: 'Modelo de datos de BE: 163 tablas, 326 claves foráneas y 108 conjuntos de valores, en 13 módulos. Ninguna clave foránea borra en cascada: todas son restrict.'
}

// ─── Identidad y acceso ───────────────────────────────────────────────────────────────────────────

Table identidad [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  estado_operativo_de_cuenta EstadoOperativoDeCuenta [not null, default: 'OPERATIVA', note: 'Estado de la cuenta: operativa, suspendida o cerrada.']
  autoria_de_creacion_id uuid [not null, note: 'Quién dio el alta; en el autorregistro, la misma cuenta.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La cuenta de BE: una por persona o profesional, estable en el tiempo. Todo lo demás cuelga de acá.'
}

Table perfil_propio [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, unique, note: 'La cuenta.']
  version_efectiva_id uuid [unique, note: 'La versión vigente del perfil.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El perfil de la cuenta. Apunta a la versión vigente; los cambios se guardan como versiones nuevas.'
}

Table version_de_perfil_propio [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  perfil_propio_id uuid [not null, note: 'El perfil propio.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  nombre_visible text [note: 'El nombre visible de la persona, que se pide al crear la cuenta.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (perfil_propio_id, numero) [unique]
  }

  Note: 'Cada versión del perfil propio (el nombre visible). Se agrega, nunca se edita.'
}

Table metodo_de_acceso [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  tipo TipoDeMetodoDeAcceso [not null, note: 'Correo y contraseña (LOCAL) o Google.']
  referencia text [not null, note: 'Con correo: el correo normalizado. Con Google: el identificador estable de la cuenta de Google.']
  correo text [note: 'Solo con Google: el correo verificado por Google, para que un correo no quede en dos cuentas.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (tipo, referencia) [unique]
    identidad_id
    correo
  }

  Note: 'Cómo entra una cuenta: con correo y contraseña o con Google. Un correo pertenece a una sola cuenta.'
}

Table cambio_de_metodo_de_acceso [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  metodo_de_acceso_id uuid [not null, note: 'El método de acceso.']
  identidad_id uuid [not null, note: 'La cuenta dueña del método.']
  numero integer [not null, note: 'Orden del cambio dentro del método: los impares son retiros y los pares, nuevas asociaciones.']
  accion AccionSobreMetodoDeAcceso [not null, note: 'Retiro o nueva asociación de la misma cuenta de Google.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (metodo_de_acceso_id, numero) [unique]
    identidad_id
  }

  Note: 'Cada retiro de un método de acceso y cada vez que se vuelve a asociar. El método no se borra: solo se retira el de Google, y solo si la cuenta conserva su contraseña.'
}

Table credencial_local [headercolor: #2F5D8A] {
  metodo_de_acceso_id uuid [pk, note: 'El método de acceso.']
  hash text [not null, note: 'Hash adaptativo de la contraseña; nunca se guarda en claro.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La contraseña del acceso por correo, guardada solo como hash. Se suprime al cerrar la cuenta.'
}

Table sesion [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  estado EstadoDeSesion [not null, default: 'ACTIVA', note: 'Activa, finalizada o revocada.']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  expira_en timestamptz(3) [not null, note: 'Cuándo vence la sesión.']
  version_de_control integer [not null, note: 'La versión del control de sesión al emitirla; si cambia, la sesión deja de valer.']
  momento_de_finalizacion timestamptz(3) [note: 'Cuándo terminó la sesión.']
  motivo_de_revocacion MotivoDeRevocacionDeSesion [note: 'Por qué se revocó; vacío si no se revocó.']
  clase ClaseDeSesion [not null, default: 'PERSONAL', note: 'Personal o administrativa; no cambia.']

  indexes {
    (identidad_id, estado)
  }

  Note: 'Cada sesión abierta en la app o en el website. Se puede cerrar o revocar desde el servidor.'
}

Table reanudacion_de_sesion [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  sesion_id uuid [not null, note: 'La sesión.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  huella text [not null, unique, note: 'Huella SHA-256 del contenido, para comprobar que no cambió.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    sesion_id
  }

  Note: 'Cada vez que el website renueva una sesión al recargar. Si se reutiliza una reanudación vieja, la sesión se revoca.'
}

Table control_de_sesion [headercolor: #2F5D8A] {
  identidad_id uuid [pk, note: 'La cuenta.']
  version integer [not null, default: 0, note: 'Contador por cuenta; al subir, invalida las sesiones anteriores.']

  Note: 'Un contador por cuenta: si cambia, todas las sesiones anteriores dejan de valer.'
}

Table recuperacion_de_acceso [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  origen OrigenDeRecuperacionDeAcceso [not null, note: 'Pedido por la persona o emitido por Administración (asistida).']
  huella text [unique, note: 'HMAC-SHA-256 del código; vacío en un pedido sin código.']
  vence_en timestamptz(3) [not null, note: 'Cuándo vence el código.']
  intentos_fallidos integer [not null, default: 0, note: 'Códigos que no valieron; con 5, el pedido se anula.']
  administrador_id uuid [note: 'En la recuperación asistida, quién la emitió.']
  fundamento text [note: 'En la asistida, cómo se verificó a la persona.']
  momento_de_uso timestamptz(3) [note: 'Cuándo se usó.']
  momento_de_anulacion timestamptz(3) [note: 'Cuándo se anuló.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
    administrador_id
  }

  Note: 'Un pedido para recuperar el acceso a la cuenta, o un código de recuperación asistida que emite Administración. Se guarda solo la huella del código.'
}

Table cambio_de_credencial [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  metodo_de_acceso_id uuid [not null, note: 'El método de acceso cuya contraseña cambió.']
  recuperacion_id uuid [not null, note: 'El pedido de recuperación que lo permitió.']
  transaccion bigint [not null, default: `txid_current()`, note: 'La transacción de la base en la que se hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
    metodo_de_acceso_id
    recuperacion_id
  }

  Note: 'Cada contraseña nueva definida con un código de recuperación, unida al pedido que la permitió.'
}

Table version_de_texto [headercolor: #2F5D8A] {
  id text [pk, note: 'Identificador único de la fila.']
  tipo TipoDeTexto [not null, note: 'Qué texto es (términos, privacidad, consentimiento u otro).']
  titulo text [not null, note: 'El título que se muestra.']
  finalidad text [not null, note: 'Para qué se pide la aceptación.']
  texto text [not null, note: 'El texto completo, tal como se muestra.']
  hash text [not null, note: 'Huella SHA-256 del texto.']
  vigente_desde timestamptz(3) [not null, note: 'Desde cuándo vale.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  reemplaza_a_id text [unique, note: 'La versión del texto a la que reemplaza.']

  Note: 'Los textos que la persona acepta (términos, privacidad, consentimientos), con su versión y su huella.'
}

Table acto_registrable [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  tipo TipoDeActoRegistrable [not null, note: 'Qué aceptó: términos, información de privacidad, datos de salud, fotos de comidas o mayoría de edad.']
  estado EstadoDeActoRegistrable [not null, default: 'VIGENTE', note: 'Vigente o revocado.']
  version_de_texto_id text [not null, note: 'El texto que se aceptó.']
  hash_del_texto text [not null, note: 'Huella SHA-256 del texto aceptado.']
  finalidad text [not null, note: 'Para qué se usa (finalidad declarada).']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  direccion_ip text [note: 'Dirección IP desde la que se pidió.']
  agente_de_usuario text [note: 'Navegador o app desde la que se pidió.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  autoria_id uuid [not null, note: 'Quién hizo el acto.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_revocacion timestamptz(3) [note: 'Cuándo se revocó; vacío si sigue vigente.']
  alcance_de_vinculo_id uuid [note: 'El área del vínculo a la que se refiere, cuando aplica.']

  indexes {
    (identidad_id, tipo, estado)
    alcance_de_vinculo_id
  }

  Note: 'Cada aceptación de la persona: qué texto aceptó, cuándo, desde dónde y si después la revocó.'
}

Table capacidad_de_cliente_declarada [headercolor: #2F5D8A] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  capacidad text [not null, note: 'La capacidad declarada por la app.']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  momento_de_primera_declaracion timestamptz(3) [not null, default: `now()`, note: 'La primera vez que se declaró.']
  momento_de_ultima_declaracion timestamptz(3) [not null, default: `now()`, note: 'La última vez que se declaró.']

  indexes {
    (identidad_id, capacidad) [unique]
  }

  Note: 'Qué capacidades declaró la versión de la app que usó una cuenta, para saber qué funciones puede ofrecerle.'
}

// ─── Administración, derechos y auditoría ─────────────────────────────────────────────────────────

Table rol_administrativo [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  estado EstadoDeRolAdministrativo [not null, default: 'VIGENTE', note: 'Vigente o retirado.']
  nombre_visible text [not null, note: 'El nombre con que figura en el historial administrativo.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  operador text [not null, note: 'Quién corrió el comando que asignó el rol.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_retiro timestamptz(3) [note: 'Cuándo se retiró.']
  fundamento_del_retiro text [note: 'Por qué se retiró.']
  operador_del_retiro text [note: 'Quién lo retiró.']

  indexes {
    identidad_id
  }

  Note: 'El rol de Administración de una cuenta, con quién lo asignó, por qué y, si corresponde, su retiro.'
}

Table codigo_de_incorporacion [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  huella text [not null, unique, note: 'Huella SHA-256 del código; el código no se guarda.']
  motivo MotivoDeCodigoDeIncorporacion [not null, note: 'Primera configuración o restablecimiento del segundo factor.']
  fundamento text [not null, note: 'Por qué se emitió.']
  operador text [not null, note: 'Quién lo emitió.']
  vence_en timestamptz(3) [not null, note: 'Cuándo deja de valer.']
  momento_de_uso timestamptz(3) [note: 'Cuándo se usó.']
  momento_de_anulacion timestamptz(3) [note: 'Cuándo se anuló.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
  }

  Note: 'El código de un solo uso para configurar el segundo factor de Administración. Se guarda solo su huella.'
}

Table factor_totp [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta (de Administración o de un profesional).']
  estado EstadoDeFactorTotp [not null, default: 'PENDIENTE', note: 'Pendiente, activo, reemplazado, revocado o descartado.']
  secreto_cifrado text [not null, note: 'El secreto del autenticador, cifrado con AES-256-GCM.']
  ultimo_paso bigint [note: 'El último paso de tiempo aceptado; impide reutilizar un código.']
  fallos_seguidos integer [not null, default: 0, note: 'Códigos inválidos seguidos; con 10 se bloquea hasta usar un código de recuperación.']
  sesion_de_configuracion_id uuid [note: 'La sesión que empezó la configuración; solo ella la confirma.']
  vence_en timestamptz(3) [note: 'Cuándo deja de valer.']
  momento_de_activacion timestamptz(3) [note: 'Cuándo quedó activo.']
  momento_de_baja timestamptz(3) [note: 'Cuándo se dio de baja.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (identidad_id, estado)
  }

  Note: 'El autenticador (código de una aplicación) de una cuenta de Administración o de un profesional, con el secreto cifrado y los intentos fallidos.'
}

Table codigo_de_recuperacion [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta (de Administración o de un profesional).']
  lote_id uuid [not null, note: 'El lote al que pertenece; un lote nuevo invalida el anterior.']
  huella text [not null, unique, note: 'HMAC-SHA-256 del código, con una clave del servidor; el código no se guarda.']
  momento_de_uso timestamptz(3) [note: 'Cuándo se usó.']
  sesion_de_uso_id uuid [note: 'La sesión en que se usó.']
  momento_de_invalidacion timestamptz(3) [note: 'Cuándo se invalidó.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (identidad_id, lote_id)
  }

  Note: 'Los códigos de recuperación del segundo factor, de un solo uso. Cada lote nuevo invalida el anterior.'
}

Table segundo_factor_de_sesion [headercolor: #5A4E8C] {
  sesion_id uuid [pk, note: 'La sesión.']
  identidad_id uuid [not null, note: 'La cuenta (la da la sesión).']
  verificado_en timestamptz(3) [note: 'Cuándo se verificó el segundo factor.']
  metodo MetodoDeSegundoFactor [note: 'Con qué se verificó: autenticador, código de recuperación o configuración inicial.']
  ultima_actividad timestamptz(3) [note: 'La última actividad de la sesión.']
  intentos_fallidos integer [not null, default: 0, note: 'Intentos fallidos en esta sesión.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
  }

  Note: 'El estado del segundo factor en cada sesión que lo exige (Administración o profesional): cuándo se verificó y la última actividad.'
}

Table restablecimiento_de_segundo_factor [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'El profesional.']
  administrador_id uuid [not null, note: 'La cuenta de Administración.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
    administrador_id
  }

  Note: 'Cada vez que Administración restablece el segundo factor de un profesional, con su fundamento.'
}

Table pedido_de_derecho [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  titular_id uuid [not null, note: 'La persona que pide.']
  tipo TipoDePedidoDeDerecho [not null, note: 'Acceso, rectificación o supresión.']
  nota text [note: 'Lo que escribió la persona, si escribió algo.']
  estado EstadoDePedidoDeDerecho [not null, default: 'RECIBIDO', note: 'Recibido, resuelto o rechazado. Se resuelve una sola vez.']
  plazo date [not null, note: 'El último día del plazo para responder (fecha de Buenos Aires).']
  respuesta text [note: 'La respuesta a la persona.']
  fundamento text [note: 'El fundamento interno de la resolución.']
  administrador_id uuid [note: 'Quién lo resolvió.']
  momento_de_resolucion timestamptz(3) [note: 'Cuándo se resolvió.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    titular_id
    (estado, plazo)
  }

  Note: 'Un pedido de la persona sobre sus datos (acceso, rectificación o supresión), con su plazo y la respuesta de Administración.'
}

Table exportacion_propia [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  titular_id uuid [not null, note: 'La persona que pidió la descarga.']
  dominios "text[]" [not null, note: 'Qué partes de sus datos incluye.']
  vence_en timestamptz(3) [not null, note: 'Hasta cuándo vale el enlace de descarga.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    titular_id
  }

  Note: 'Cada descarga de sus propios datos que pide la persona: qué dominios incluye y hasta cuándo vale el enlace.'
}

Table decision_de_acceso [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  operacion text [not null, note: 'La operación de la API a la que se refiere.']
  resultado ResultadoDeDecision [not null, note: 'Permitida o denegada.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  sujeto_id uuid [note: 'La cuenta cuyos datos se tocan.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  dimensiones_desfavorables "DimensionDeAutorizacion[]" [not null, note: 'La condición que faltó: rol, especialidad o capacidad, situación, vínculo, consentimiento, finalidad o alcance.']
  alcance_de_vinculo_id uuid [note: 'El área del vínculo.']
  consentimiento_id uuid [note: 'El consentimiento.']
  version_de_consentimiento_id uuid [note: 'La versión de consentimiento que resolvió la decisión.']
  version_de_matriz text [note: 'Versión de la matriz de pertinencia aplicada, si la hay.']
  recurso_tipo text [note: 'Tipo del recurso al que se refiere el hecho.']
  recurso_id uuid [note: 'Identificador del recurso al que se refiere el hecho.']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  request_id text [note: 'Identificador del pedido HTTP, para encontrarlo en el registro de la API.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (actor_id, sujeto_id, alcance, momento_de_registro)
  }

  Note: 'Cada decisión del punto único de autorización sobre una operación protegida: quién, sobre quién, qué y por qué.'
}

Table registro_de_auditoria [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  operacion text [not null, note: 'La operación de la API a la que se refiere.']
  resultado ResultadoDeOperacion [not null, note: 'Cómo terminó la operación.']
  motivo text [note: 'Código interno del resultado; nunca se muestra afuera.']
  actor_id uuid [note: 'Quién hizo la acción.']
  sujeto_id uuid [note: 'La cuenta afectada, si la hay.']
  recurso_tipo text [note: 'Tipo del recurso al que se refiere el hecho.']
  recurso_id text [note: 'Identificador del recurso al que se refiere el hecho.']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  request_id text [note: 'Identificador del pedido HTTP, para encontrarlo en el registro de la API.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    sujeto_id
    (operacion, momento_de_registro)
  }

  Note: 'La auditoría de cada operación, escrita en la misma transacción. Sin IP ni datos en claro.'
}

Table registro_de_idempotencia [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  operacion text [not null, note: 'La operación de la API a la que se refiere.']
  ambito text [not null, note: 'Quién pidió: la cuenta autenticada o «PUBLICO».']
  clave text [not null, note: 'La clave de idempotencia que mandó el cliente.']
  huella text [not null, note: 'Huella SHA-256 del contenido, para comprobar que no cambió.']
  estado_http integer [not null, note: 'El código HTTP de la respuesta original.']
  cuerpo jsonb [not null, note: 'El cuerpo de la respuesta original, que se devuelve igual en un reintento.']
  decisiones jsonb [note: 'Las decisiones de acceso del pedido original, que el reintento vuelve a verificar.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (operacion, ambito, clave) [unique]
  }

  Note: 'La respuesta guardada de cada escritura con clave de idempotencia, para que un reintento no duplique nada.'
}

Table evento_de_dominio [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  tipo TipoDeEventoDeDominio [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  identidad_id uuid [not null, note: 'La cuenta.']
  actor_id uuid [note: 'Quién hizo la acción.']
  actor_servicio text [note: 'El servicio interno que actuó, cuando no fue una cuenta.']
  autoria_id uuid [note: 'Quién hizo el acto.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  estado_anterior EstadoOperativoDeCuenta [note: 'Estado de la cuenta antes del hecho.']
  estado_resultante EstadoOperativoDeCuenta [note: 'Estado de la cuenta después del hecho.']
  datos jsonb [note: 'Datos del hecho, sin información sensible.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (identidad_id, tipo)
  }

  Note: 'Los hechos de la cuenta (alta, cambios de estado, cierre), en orden y sin modificar.'
}

Table solicitud_de_cierre_de_cuenta [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, unique, note: 'La cuenta.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  version_de_consecuencias_id text [not null, note: 'El texto de consecuencias que la persona aceptó al pedir el cierre.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El pedido de cerrar la cuenta, con quién lo pidió y qué consecuencias aceptó.'
}

Table registro_de_supresion [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  categoria text [not null, note: 'Qué categoría de dato se suprimió.']
  sujeto_id uuid [not null, note: 'La cuenta a la que pertenecía el dato.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  ejecutor text [not null, note: 'Quién o qué ejecutó la supresión.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    sujeto_id
  }

  Note: 'Lo que se suprimió de verdad (por ejemplo, una contraseña al cerrar la cuenta), con su fundamento.'
}

Table incidencia [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  reportante_id uuid [not null, note: 'Quién la reportó: una persona o un profesional.']
  categoria CategoriaDeIncidencia [not null, note: 'Acceso, perfil, vínculo, integridad de los datos o funcionamiento.']
  descripcion text [not null, note: 'Lo que escribió quien la reportó; no cambia.']
  estado EstadoDeIncidencia [not null, default: 'ABIERTA', note: 'Abierta, en curso o resuelta; cambia solo con un cambio registrado antes.']
  version integer [not null, default: 0, note: 'Cuántos cambios tuvo; cada cambio declara la versión que leyó.']
  responsable_id uuid [note: 'La cuenta de Administración que registró el último cambio: quien la tiene a cargo o quien la resolvió.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (reportante_id, momento_de_registro)
    (estado, momento_de_registro)
  }

  Note: 'Una incidencia que reportó una persona o un profesional. La descripción y la categoría no cambian; el estado y quién la tiene a cargo cambian solo con un cambio registrado.'
}

Table cambio_de_incidencia [headercolor: #5A4E8C] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  incidencia_id uuid [not null, note: 'Referencia a incidencia.']
  numero integer [not null, note: 'La versión de la incidencia que deja este cambio (1, 2, 3…).']
  estado_anterior EstadoDeIncidencia [not null, note: 'El estado antes del cambio.']
  estado_nuevo EstadoDeIncidencia [not null, note: 'El estado después del cambio.']
  motivo text [not null, note: 'Por qué cambió; lo ve Administración.']
  respuesta text [note: 'Lo que se le responde a quien la reportó; obligatoria al resolverla.']
  administrador_id uuid [not null, note: 'La cuenta de Administración.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (incidencia_id, numero) [unique]
  }

  Note: 'Cada cambio de estado de una incidencia: el motivo, la respuesta para quien la reportó y la cuenta de Administración que lo registró. Solo se agrega.'
}

// ─── Profesionales, vínculos y consentimiento ─────────────────────────────────────────────────────

Table perfil_profesional [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, unique, note: 'La cuenta.']
  tipo TipoDePerfilProfesional [not null, note: 'Si el profesional es del área de salud (SANITARIO) o no.']
  nombre_visible text [not null, note: 'Nombre con el que se muestra. Solo cambia junto con su fila en cambio_de_nombre_profesional.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  matricula_numero text [note: 'Número de matrícula verificado, para un profesional de salud incorporado por Administración.']
  matricula_jurisdiccion text [note: 'Jurisdicción de la matrícula. Van las dos o ninguna.']

  Note: 'El perfil profesional de una cuenta: nombre visible, si es del área de salud y, si corresponde, su matrícula. No habilita nada por sí solo.'
}

Table cambio_de_nombre_profesional [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'El profesional.']
  nombre_anterior text [not null, note: 'El nombre que tenía.']
  nombre_nuevo text [not null, note: 'El nombre que pasa a tener.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  administrador_id uuid [not null, note: 'La cuenta de Administración.']
  transaccion bigint [not null, default: `txid_current()`, note: 'La transacción de la base en la que se hizo el cambio; une el cambio con la modificación del perfil.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
    administrador_id
  }

  Note: 'Cada cambio del nombre de un profesional hecho por Administración, con el nombre anterior, el nuevo y el fundamento.'
}

Table verificacion_profesional [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  estado EstadoDeVerificacionProfesional [not null, default: 'PENDIENTE', note: 'Pendiente, verificado, rechazado o suspendido.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_ultima_transicion timestamptz(3) [note: 'Cuándo cambió de estado por última vez.']

  indexes {
    (identidad_id, alcance) [unique]
  }

  Note: 'La verificación de un profesional por área. La historia de cada paso está en evento_de_verificacion.'
}

Table habilitacion [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  estado EstadoDeHabilitacion [not null, default: 'CONCEDIDA', note: 'Concedida o retirada.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_ultima_transicion timestamptz(3) [note: 'Cuándo cambió de estado por última vez.']

  indexes {
    (identidad_id, alcance) [unique]
  }

  Note: 'La habilitación para operar en BE por área, separada de la verificación.'
}

Table evento_de_verificacion [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeVerificacion [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  identidad_id uuid [not null, note: 'La cuenta.']
  alcance Alcance [note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  estado_previo text [note: 'Estado antes del hecho.']
  estado_posterior text [note: 'Estado después del hecho.']
  fundamento text [note: 'Fundamento escrito por quien decide.']
  actor_servicio text [note: 'El servicio interno que actuó, cuando no fue una cuenta.']
  tipo_de_actor TipoDeActorDeVerificacion [not null, note: 'Quién decidió: el servicio interno o una cuenta de Administración.']
  administrador_id uuid [note: 'La cuenta de Administración que decidió, si fue una.']
  mensaje_al_profesional text [note: 'Lo que se le comunicó al profesional, separado del fundamento interno.']
  version_previa integer [note: 'La versión de la trayectoria al decidir, para detectar decisiones simultáneas.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (identidad_id, alcance)
    administrador_id
  }

  Note: 'Cada paso de la verificación y la habilitación (verificar, rechazar, suspender, rehabilitar), con su fundamento.'
}

Table capacidad_profesional [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  identidad_id uuid [not null, note: 'La cuenta.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  modo ModoDeCapacidad [not null, note: 'Con límite o sin límite.']
  limite integer [note: 'Cuántas personas puede acompañar, si hay límite.']
  actor_servicio text [not null, note: 'El servicio interno que actuó, cuando no fue una cuenta.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    identidad_id
  }

  Note: 'Cuántas personas puede acompañar un profesional. Cada cambio es una versión nueva.'
}

Table invitacion_de_vinculo [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  hash_del_token text [not null, unique, note: 'Huella SHA-256 del token del enlace; el token no se guarda.']
  hash_del_codigo text [not null, unique, note: 'Huella SHA-256 del código corto; única entre todas las invitaciones.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  vence_en timestamptz(3) [not null, note: 'Cuándo deja de valer.']

  indexes {
    (profesional_id, momento_de_registro, id)
  }

  Note: 'La invitación de un profesional por enlace, QR o código. Se guardan solo las huellas del enlace y del código.'
}

Table resolucion_de_invitacion [headercolor: #1F7A70] {
  invitacion_id uuid [pk, note: 'La invitación.']
  tipo TipoDeResolucionDeInvitacion [not null, note: 'Usada o revocada.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  solicitud_de_vinculo_id uuid [note: 'El pedido de vínculo que creó al usarse.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    solicitud_de_vinculo_id
    actor_id
  }

  Note: 'Cómo terminó una invitación: usada o revocada. Una sola por invitación.'
}

Table solicitud_de_vinculo [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  iniciador RolEnVinculo [not null, note: 'Quién inició el pedido: el profesional o la persona.']
  estado EstadoDeSolicitudDeVinculo [not null, default: 'PENDIENTE', note: 'Pendiente, aceptada, rechazada, caducada o invalidada.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  antecedente_id uuid [note: 'El pedido anterior, si este lo reitera.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  vence_en timestamptz(3) [not null, note: 'Cuándo deja de valer.']
  momento_de_resolucion timestamptz(3) [note: 'Cuándo dejó de estar pendiente.']

  indexes {
    (profesional_id, estado)
    (asesorado_id, estado)
  }

  Note: 'El pedido de vínculo entre un profesional y una persona para un área, con su estado.'
}

Table vinculo [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id) [unique]
  }

  Note: 'El vínculo entre un profesional y una persona. Agrupa un componente por área.'
}

Table alcance_de_vinculo [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  vinculo_id uuid [not null, note: 'El vínculo.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  solicitud_de_origen_id uuid [not null, unique, note: 'El pedido que le dio origen.']
  estado EstadoDeAlcanceDeVinculo [not null, default: 'ACEPTADO', note: 'Aceptado, en pausa o finalizado.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  pausado_por RolEnVinculo [note: 'Mientras está en pausa: quién pausó (solo esa parte puede reanudar).']
  motivo_de_ultima_transicion MotivoDeTransicionDeVinculo [note: 'Por qué cambió de estado la última vez.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (vinculo_id, alcance)
  }

  Note: 'Un área dentro del vínculo (Nutrición, Entrenamiento o Antropometría), con su propio estado.'
}

Table consentimiento [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  alcance_de_vinculo_id uuid [not null, note: 'El área del vínculo.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  situacion SituacionDeConsentimiento [not null, default: 'VIGENTE', note: 'Vigente o revocado.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (alcance_de_vinculo_id, finalidad) [unique]
  }

  Note: 'El consentimiento de la persona para un área del vínculo y una finalidad.'
}

Table version_de_consentimiento [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  consentimiento_id uuid [not null, note: 'El consentimiento.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  decision DecisionDeConsentimiento [not null, note: 'Otorgamiento, nueva versión, revocación o nuevo otorgamiento.']
  situacion_resultante SituacionDeConsentimiento [not null, note: 'La situación que deja esta decisión.']
  version_de_texto_id text [note: 'El texto que se aceptó.']
  hash_del_texto text [note: 'Huella SHA-256 del texto aceptado.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  finalidad Finalidad [not null, note: 'La finalidad del área: acompañamiento nutricional, planificación del entrenamiento o evaluación antropométrica.']
  categorias jsonb [not null, default: '[]', note: 'Categorías de datos alcanzadas.']
  version_de_matriz text [note: 'Versión de la matriz de pertinencia aplicada, si la hay.']
  superficie Superficie [note: 'Desde dónde se hizo: website (WEB) o app (APK).']
  direccion_ip text [note: 'Dirección IP desde la que se pidió.']
  agente_de_usuario text [note: 'Navegador o app desde la que se pidió.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  autoria_id uuid [not null, note: 'Quién hizo el acto.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    consentimiento_id
  }

  Note: 'Cada decisión sobre un consentimiento (otorgar, revocar), con el texto aceptado y su huella.'
}

Table evento_de_vinculo [headercolor: #1F7A70] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeVinculo [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  solicitud_de_vinculo_id uuid [note: 'El pedido de vínculo involucrado, si lo hay.']
  alcance_de_vinculo_id uuid [note: 'El área del vínculo.']
  consentimiento_id uuid [note: 'El consentimiento.']
  version_de_consentimiento_id uuid [note: 'La decisión de consentimiento involucrada, si la hay.']
  estado_previo text [note: 'Estado antes del hecho.']
  estado_posterior text [not null, note: 'Estado después del hecho.']
  motivo MotivoDeTransicionDeVinculo [note: 'Motivo del cambio, si lo hay.']
  actor_id uuid [note: 'Quién hizo la acción.']
  actor_servicio text [note: 'El servicio interno que actuó, cuando no fue una cuenta.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, momento_de_registro)
    solicitud_de_vinculo_id
    alcance_de_vinculo_id
    consentimiento_id
  }

  Note: 'Los hechos del vínculo (solicitud, aceptación, pausa, finalización), con estado previo y posterior.'
}

// ─── Proceso de acompañamiento ────────────────────────────────────────────────────────────────────

Table proceso_operativo [headercolor: #7A5C1F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  estado EstadoDeProceso [not null, default: 'ABIERTO', note: 'Abierto o cerrado.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  motivo_de_cierre MotivoDeCierreDeProceso [note: 'Por qué se cerró.']
  version_de_apertura_id uuid [unique, note: 'La versión de plan de comidas que abrió el proceso, si es de Nutrición.']
  version_de_apertura_entrenamiento_id uuid [unique, note: 'La versión de plan de entrenamiento que abrió el proceso, si es de Entrenamiento.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_cierre timestamptz(3) [note: 'Cuándo se cerró.']

  indexes {
    (profesional_id, asesorado_id, alcance)
  }

  Note: 'El acompañamiento de una persona en un área: se abre con el primer plan activado y se cierra con fundamento.'
}

Table evento_de_proceso [headercolor: #7A5C1F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeProceso [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  proceso_id uuid [not null, note: 'El proceso de acompañamiento.']
  tipo_de_aplicacion TipoDeAplicacion [note: 'Qué se aplicó, si el hecho viene de una revisión.']
  revision_id uuid [note: 'La revisión de Nutrición involucrada, si la hay.']
  revision_de_entrenamiento_id uuid [note: 'La revisión de Entrenamiento involucrada, si la hay.']
  estado_previo EstadoDeProceso [note: 'Estado antes del hecho.']
  estado_posterior EstadoDeProceso [not null, note: 'Estado después del hecho.']
  datos jsonb [note: 'Las versiones involucradas, cuando corresponde.']
  actor_id uuid [note: 'Quién hizo la acción.']
  actor_servicio text [note: 'El servicio interno que actuó, cuando no fue una cuenta.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    proceso_id
  }

  Note: 'Los hechos del proceso: apertura, revisiones aplicadas, continuidad o cierre.'
}

Table proxima_revision [headercolor: #7A5C1F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  proceso_id uuid [not null, note: 'El proceso de acompañamiento.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  fecha_objetivo date [note: 'El día previsto; vacío si quedó sin fecha.']
  fuente FuenteDeProximaRevision [not null, note: 'De dónde salió la fecha: una versión de plan o una revisión.']
  version_de_plan_id uuid [note: 'La versión de plan de comidas que la fijó, si es de Nutrición.']
  version_de_plan_de_entrenamiento_id uuid [note: 'La versión de plan de entrenamiento que la fijó, si es de Entrenamiento.']
  revision_id uuid [note: 'La revisión de Nutrición que la fijó, si la hay.']
  revision_de_entrenamiento_id uuid [note: 'La revisión de Entrenamiento que la fijó, si la hay.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    proceso_id
  }

  Note: 'Cuándo toca la próxima revisión. Reprogramar crea una fila nueva y la anterior queda en la historia.'
}

Table resultado_tvcc30 [headercolor: #7A5C1F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  especificacion text [not null, note: 'Versión de la especificación del indicador.']
  mapeo text [not null, note: 'Versión del mapeo de datos usado.']
  corte date [not null, note: 'El día hasta el que se tomaron los datos.']
  zona text [not null, note: 'Zona horaria del cálculo.']
  ventana_inicio timestamptz(3) [not null, note: 'Inicio de la ventana de 30 días.']
  ventana_fin timestamptz(3) [not null, note: 'Fin de la ventana.']
  estado EstadoDeResultadoTvcc30 [not null, note: 'Calculado o sin valor.']
  motivo_sin_valor text [note: 'Por qué no hubo valor, si no lo hubo.']
  numerador integer [note: 'Ciclos elegibles que tuvieron su revisión aplicada, con continuidad o cierre, antes de que terminara la ventana.']
  denominador integer [note: 'Ciclos elegibles: los que vencieron en la ventana, sin los excluidos ni los que no se pudieron clasificar.']
  universo integer [not null, note: 'Ciclos en el universo antes de excluir.']
  excluidos integer [not null, note: 'Ciclos excluidos, con su motivo en el resultado.']
  no_resolubles integer [not null, note: 'Ciclos que no se pudieron clasificar.']
  resultado jsonb [not null, note: 'El resultado completo: cada ciclo con su clasificación, motivo y fuentes.']
  huella text [not null, note: 'Huella SHA-256 del contenido, para comprobar que no cambió.']
  predecesor_id uuid [unique, note: 'La corrida anterior sobre los mismos datos; vacía en la primera.']
  ejecutor text [not null, note: 'Quién pidió la corrida.']
  ambiente text [not null, note: 'Ambiente en el que se calculó.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (corte, zona)
  }

  Note: 'Cada cálculo de la TVCC-30, la tasa de ciclos de seguimiento cerrados en 30 días, con su universo, su ventana y su resultado completo.'
}

Table nota_propia [headercolor: #7A5C1F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  texto text [not null, note: 'El texto de la nota, de 1 a 1.000 caracteres.']
  ancla AnclaDeNotaPropia [note: 'A qué se refiere, si a algo: un ejercicio o una comida.']
  ejercicio_id uuid [note: 'El ejercicio, cuando la nota está anclada a uno.']
  comida text [note: 'La comida, cuando la nota está anclada a una.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id)
    asesorado_id
  }

  Note: 'La nota que un profesional escribe para sí sobre una persona, opcionalmente anclada a un ejercicio o a una comida. En BE solo la ve su autor; como es un dato sobre la persona, entra en la exportación de sus datos.'
}

Table archivo_de_nota_propia [headercolor: #7A5C1F] {
  nota_id uuid [pk, note: 'La nota archivada (una sola vez).']
  profesional_id uuid [not null, note: 'El autor de la nota: el único que la puede archivar.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El archivo de una nota propia, una sola vez y por su autor. La nota no se borra: sigue en la historia.'
}

// ─── Nutrición ────────────────────────────────────────────────────────────────────────────────────

Table elemento_de_catalogo_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  procedencia ProcedenciaDeCatalogo [not null, note: 'Cómo entró al catálogo: semilla sintética de BE, carga de un profesional o importación revisada.']
  creado_por_id uuid [note: 'El profesional que lo cargó; vacío en el catálogo de base.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Un alimento del catálogo, con un identificador estable. Su contenido vive en las versiones.'
}

Table version_de_elemento_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  elemento_id uuid [not null, note: 'El alimento.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  nombre text [not null, note: 'Nombre visible.']
  composicion jsonb [not null, note: 'La composición nutricional, con su fuente.']
  disponibilidad DisponibilidadDeElemento [not null, note: 'Si se puede elegir para planes nuevos o está retirado.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    elemento_id
  }

  Note: 'Cada versión de un alimento: nombre, composición y disponibilidad.'
}

Table evaluacion_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  contexto text [note: 'Contexto de la evaluación.']
  valoracion jsonb [not null, note: 'Los datos evaluados, cada uno con su fuente: informado, observado o calculado.']
  referencias jsonb [not null, note: 'Referencias que usó el profesional.']
  notas text [note: 'Las «Anotaciones» del profesional, hasta 4.000 caracteres: ninguna lectura de la persona las devuelve.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, profesional_id, momento_de_registro)
  }

  Note: 'La evaluación nutricional del profesional, con la fuente de cada dato. Una nueva no reemplaza a la anterior.'
}

Table objetivo_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id) [unique]
  }

  Note: 'El objetivo nutricional de una persona con un profesional. Apunta a sus versiones.'
}

Table version_de_objetivo_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  objetivo_id uuid [not null, note: 'El objetivo.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  evaluacion_id uuid [not null, note: 'La evaluación en la que se apoya.']
  vigente_desde timestamptz(3) [not null, note: 'Desde cuándo vale.']
  vigente_hasta timestamptz(3) [note: 'Hasta cuándo valió; vacío si sigue vigente.']
  requerimiento_energetico jsonb [not null, note: 'El requerimiento energético que decide el profesional, con su método.']
  distribucion_de_macronutrientes jsonb [not null, note: 'Cómo se reparten proteínas, grasas e hidratos.']
  distribucion_por_comida text [note: 'Cómo se reparte el día entre comidas, si se indica.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  declaracion_de_metodo text [note: 'El método que declara el profesional, si lo indica.']
  revision_de_origen_id uuid [note: 'La revisión que la originó, si la hay.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    objetivo_id
  }

  Note: 'Cada versión del objetivo: requerimiento, distribución de macronutrientes y fundamento del profesional.'
}

Table plan_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  version_efectiva_id uuid [unique, note: 'La versión vigente del plan.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id) [unique]
  }

  Note: 'El plan de comidas de una persona con un profesional. Apunta a la versión vigente.'
}

Table version_de_plan_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  plan_id uuid [not null, note: 'El plan al que pertenece.']
  predecesora_id uuid [note: 'La fila anterior de la cadena; vacía en la primera.']
  estado EstadoDeVersionDePlan [not null, default: 'BORRADOR', note: 'Borrador, activada o descartada.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  version_de_objetivo_id uuid [not null, note: 'La versión de objetivo a la que responde.']
  contenido jsonb [not null, note: 'Días tipo, comidas y opciones con sus alimentos o recetas.']
  proxima_revision date [note: 'Cuándo toca revisar esta versión.']
  revision_de_origen_id uuid [note: 'La revisión que la originó, si la hay.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_activacion timestamptz(3) [note: 'Cuándo se activó.']
  origen_de_plantilla jsonb [note: 'De qué plantilla y versión salió este borrador, si salió de una.']

  indexes {
    plan_id
  }

  Note: 'Cada versión del plan: borrador, activada o descartada. Una versión activada no se modifica.'
}

Table instantanea_de_plan_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  version_de_plan_id uuid [not null, unique, note: 'La versión de plan.']
  contenido jsonb [not null, note: 'El plan tal como se emitió, con el catálogo resuelto.']
  huella text [not null, note: 'Huella SHA-256 del contenido, para comprobar que no cambió.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Lo que se emitió al activar una versión, con el catálogo resuelto y su huella, para reconstruirlo igual.'
}

Table rangos_de_plan_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  version_de_plan_id uuid [not null, unique, note: 'La versión del plan a la que pertenecen (uno a uno).']
  revision integer [not null, note: 'Revisión propia de los rangos: empieza en 1 y avanza de a uno en cada guardado del borrador.']
  contenido jsonb [not null, note: 'Los rangos por día tipo y por comida, en gramos, con el peso del que salieron; validados por el dominio antes de guardarse.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Los rangos de macronutrientes que el profesional indica en una versión del plan, por día tipo y por comida, en gramos y con el peso del que salieron. Se escriben en el borrador y, activada la versión, quedan fijos con ella.'
}

Table ingesta_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  version_de_plan_id uuid [not null, note: 'La versión activada contra la que se registró.']
  asesorado_id uuid [not null, note: 'La persona.']
  origen OrigenDeIngesta [not null, note: 'Del plan o fuera del plan (algo diferente).']
  modo ModoDeRegistroDeIngesta [not null, note: 'Eligiendo una opción del plan o con descripción libre.']
  fecha_local date [not null, note: 'El día, según la zona horaria de la persona.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  dia_tipo_id text [note: 'El día tipo del plan, por su identificador estable.']
  comida_id text [note: 'La comida del plan, por su identificador estable.']
  opcion_id text [note: 'La opción del plan que eligió la persona.']
  items_consumidos jsonb [not null, default: '[]', note: 'Lo que comió, ítem por ítem.']
  observacion text [note: 'Una observación de la persona.']
  descripcion text [note: 'Lo que la persona escribió, cuando comió algo diferente. Se conserva siempre.']
  descripcion_de_porcion text [note: 'La porción, descrita por la persona.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  secuencia integer [not null, default: 0, note: 'Orden total de los hechos.']
  cantidades_consumidas jsonb [note: 'Estado de las cantidades y sus ítems resueltos, cuando se completaron.']
  version_de_receta_id uuid [note: 'La versión de receta, si la opción era una receta.']
  dia_tipo_de_contexto_id text [note: 'Cuando comió algo diferente: el día del plan en que lo hizo.']
  comida_de_contexto_id text [note: 'Cuando comió algo diferente: la comida del plan que reemplazó.']

  indexes {
    (asesorado_id, fecha_local)
    version_de_plan_id
  }

  Note: 'Cada comida que registra la persona: la del plan, otra opción o algo diferente. No toca lo indicado.'
}

Table correccion_de_ingesta [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ingesta_id uuid [not null, note: 'La comida registrada.']
  correccion_previa_id uuid [unique, note: 'La corrección anterior de la cadena.']
  estimacion jsonb [not null, note: 'La estimación del profesional.']
  declaracion text [not null, note: 'La declaración que acompaña la estimación (no es una medición).']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ingesta_id
  }

  Note: 'La corrección del profesional sobre una comida libre: una estimación con su declaración, en cadena.'
}

Table revision_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  proceso_id uuid [not null, note: 'El proceso de acompañamiento.']
  periodo_inicio date [not null, note: 'Primer día del período revisado.']
  periodo_fin date [not null, note: 'Último día del período revisado.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  evidencias jsonb [not null, note: 'Lo que el profesional miró para decidir (registros, tomas, respuestas).']
  interpretacion text [not null, note: 'Lo que el profesional interpreta de la evidencia.']
  resultado ResultadoDeRevision [not null, note: 'Mantener, ajustar, sustituir, reprogramar la revisión, cambiar el objetivo o finalizar.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  proxima_accion jsonb [not null, note: 'Lo que sigue: próxima revisión, ajuste o cierre.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    proceso_id
  }

  Note: 'La revisión del profesional sobre un período: evidencia, interpretación, resultado y próxima acción.'
}

Table aplicacion_de_revision [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  revision_id uuid [not null, unique, note: 'La revisión.']
  evento_id uuid [not null, unique, note: 'El hecho del proceso que deja la aplicación.']
  tipo TipoDeAplicacion [not null, note: 'Continuidad o cierre del proceso.']
  estado_de_proceso_posterior EstadoDeProceso [not null, note: 'Cómo queda el proceso.']
  version_de_plan_creada_id uuid [note: 'La versión de plan que creó, si creó una.']
  version_de_objetivo_creada_id uuid [note: 'La versión de objetivo que creó, si creó una.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Lo que se hizo con una revisión: seguir, ajustar el plan o cerrar el proceso.'
}

Table evento_de_nutricion [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeNutricion [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  profesional_id uuid [note: 'El profesional involucrado, si lo hay.']
  asesorado_id uuid [note: 'La persona involucrada, si la hay.']
  recurso_tipo text [not null, note: 'Tipo del recurso al que se refiere el hecho.']
  recurso_id uuid [not null, note: 'Identificador del recurso al que se refiere el hecho.']
  estado_previo text [note: 'Estado antes del hecho.']
  estado_posterior text [note: 'Estado después del hecho.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, momento_de_registro)
    recurso_id
  }

  Note: 'Los hechos del área de Nutrición, en orden, para reconstruir la historia.'
}

Table cita_de_respuesta_en_evaluacion_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  evaluacion_id uuid [not null, note: 'La evaluación a la que pertenece.']
  respuesta_id uuid [not null, note: 'La respuesta.']
  rectificacion_id uuid [note: 'La rectificación vigente al citar; `null` si lo vigente era la respuesta original.']
  codigo_de_campo text [not null, note: 'El campo del formulario citado.']
  orden integer [not null, note: 'Posición en la lista.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (evaluacion_id, orden) [unique]
    (evaluacion_id, respuesta_id, codigo_de_campo) [unique]
    respuesta_id
  }

  Note: 'Una respuesta de formulario citada en una evaluación de Nutrición: es una referencia, no una copia, y fija la versión vigente al citar.'
}

Table calculo_del_objetivo_nutricional [headercolor: #3E7D32] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  version_de_objetivo_id uuid [not null, unique, note: 'La versión de objetivo a la que responde.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  evaluacion_antropometrica_id uuid [note: 'La toma de referencia, si la hay; nula si la referencia es a mano.']
  contenido jsonb [not null, note: '{ reference, data, parameters, result }: lo que se usó y lo que dio, tal cual.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id)
    evaluacion_antropometrica_id
  }

  Note: 'Con qué se escribió una versión del objetivo: la toma de Antropometría o los datos a mano, los valores usados, el método y sus parámetros. Solo se agrega.'
}

// ─── Recetas, fotos y registro de comidas ─────────────────────────────────────────────────────────

Table receta [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [note: 'El profesional dueño; vacío en una receta del Recetario de BE.']
  version integer [not null, default: 1, note: 'Versión de la fila; cada escritura declara la que leyó y, si otro la cambió antes, hay conflicto.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (profesional_id, momento_de_actualizacion)
  }

  Note: 'Una receta propia del profesional o, sin profesional, del Recetario de BE.'
}

Table version_de_receta [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  receta_id uuid [not null, note: 'La receta.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  nombre text [not null, note: 'Nombre visible.']
  descripcion text [note: 'Descripción, si la hay.']
  porciones integer [not null, note: 'Cuántas porciones rinde.']
  pasos jsonb [not null, note: 'Los pasos de la preparación.']
  ingredientes jsonb [not null, note: 'Cada ingrediente: alimento y versión del catálogo, cantidad, unidad y estado.']
  metodo_de_calculo MetodoDeCalculoNutricional [not null, note: 'Cómo se calculó el aporte: suma de los ingredientes según su fuente por 100 g.']
  resultado jsonb [not null, note: 'El aporte calculado por porción y total.']
  autor_id uuid [note: 'Quién escribió la versión; vacío solo en una receta del recetario sembrada por BE.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (receta_id, numero) [unique]
  }

  Note: 'Cada versión de una receta: porciones, pasos, ingredientes y el cálculo nutricional con su método.'
}

Table asociacion_de_imagen_de_receta [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  receta_id uuid [not null, note: 'La receta.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  cambio CambioDeImagenDeReceta [not null, note: 'Asociar o retirar; asociar otra reemplaza la vigente.']
  medio_id uuid [note: 'La imagen.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (receta_id, numero) [unique]
    medio_id
  }

  Note: 'Cada cambio de la imagen de una receta. La vigente es la de mayor número.'
}

Table medio [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  propietario_id uuid [not null, note: 'La cuenta dueña de la imagen.']
  finalidad FinalidadDeMedio [not null, note: 'Para qué es: imagen de receta, foto de comida o imagen de ejercicio.']
  estado EstadoDeMedio [not null, default: 'PENDIENTE', note: 'Pendiente de subir, disponible o suprimido.']
  procedencia_de_imagen ProcedenciaDeImagen [not null, note: 'De dónde viene la imagen, tal como la declaró quien la subió. La foto de una comida es siempre aportada por la persona.']
  autoria text [note: 'Autoría declarada, si la hay.']
  tipo_declarado text [not null, note: 'Tipo de archivo que el cliente declaró antes de subir.']
  bytes_declarados integer [not null, note: 'Tamaño declarado antes de subir.']
  tipo_original text [note: 'Tipo de archivo recibido.']
  bytes_originales integer [note: 'Tamaño recibido.']
  ancho_original integer [note: 'Ancho recibido, en píxeles.']
  alto_original integer [note: 'Alto recibido, en píxeles.']
  sha256_original text [note: 'Huella de lo recibido.']
  tipo_procesado text [note: 'Tipo guardado: JPEG recodificado, sin metadatos.']
  bytes_procesados integer [note: 'Tamaño guardado.']
  ancho_procesado integer [note: 'Ancho guardado, en píxeles.']
  alto_procesado integer [note: 'Alto guardado, en píxeles.']
  sha256_procesado text [note: 'Huella de lo guardado.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_subida timestamptz(3) [note: 'Cuándo se completó la subida.']
  momento_de_supresion timestamptz(3) [note: 'Cuándo se suprimió, si se suprimió.']
  motivo_de_supresion text [note: 'Por qué se suprimió.']

  indexes {
    (propietario_id, finalidad, estado)
    (propietario_id, sha256_original)
  }

  Note: 'Los datos de una imagen privada (foto de comida, de receta o de ejercicio): tipo, tamaño, huellas y estado.'
}

Table contenido_de_medio [headercolor: #8A6A12] {
  medio_id uuid [pk, note: 'La imagen.']
  bytes bytea [not null, note: 'Los bytes de la imagen procesada.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Los bytes procesados de una imagen, recodificada y sin metadatos.'
}

Table evidencia_visual_de_ingesta [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ingesta_id uuid [not null, note: 'La comida registrada.']
  medio_id uuid [not null, unique, note: 'La imagen.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ingesta_id
  }

  Note: 'La foto de una comida unida a su registro. Una foto pertenece a un solo registro.'
}

Table anulacion_de_ingesta [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ingesta_id uuid [not null, unique, note: 'La comida registrada.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  motivo text [note: 'Por qué se deshizo, si la persona lo dijo.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: '«Deshacer registro»: la comida deja de contar, pero no se borra.'
}

Table rectificacion_de_cantidades [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ingesta_id uuid [not null, note: 'La comida registrada.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  cantidades jsonb [not null, note: 'Las cantidades consumidas de cada ítem.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ingesta_id
  }

  Note: '«Completar cantidades»: las cantidades consumidas de una comida del plan, en cadena de rectificaciones.'
}

Table variante_de_medio [headercolor: #8A6A12] {
  medio_id uuid [note: 'El medio del que es variante.']
  variante VarianteDeMedio [note: 'Miniatura o grande.']
  tipo text [not null, note: 'Siempre image/webp.']
  bytes integer [not null, note: 'El tamaño, que coincide con el contenido.']
  ancho integer [not null, note: 'El ancho, en píxeles.']
  alto integer [not null, note: 'El alto, en píxeles.']
  sha256 text [not null, note: 'La huella del contenido.']
  contenido bytea [not null, note: 'Días tipo, comidas y opciones con sus alimentos o recetas.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (medio_id, variante) [pk]
  }

  Note: 'Las medidas livianas de la imagen de una receta, armadas la primera vez que se piden. No se reescriben; se borran solo al suprimir el medio.'
}

Table receta_del_recetario [headercolor: #8A6A12] {
  receta_id uuid [pk, note: 'La receta, sin profesional.']
  propuesta_id uuid [unique, note: 'La propuesta de la que salió, si la sumó Administración.']
  administrador_id uuid [note: 'Quién la sumó, con su rol vigente.']
  clave_de_semilla text [unique, note: 'La clave editorial, si la sembró BE.']
  procedencia jsonb [not null, note: 'De dónde vino la fila.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Una receta del Recetario de BE: la suma un administrador desde una propuesta o la siembra BE. Solo se agrega.'
}

Table copia_de_receta_del_recetario [headercolor: #8A6A12] {
  receta_id uuid [pk, note: 'La receta propia que salió de la copia.']
  origen_id uuid [not null, note: 'La receta del recetario que se copió.']
  procedencia jsonb [not null, note: 'De dónde vino la fila.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    origen_id
  }

  Note: 'De qué receta del recetario sale una receta propia. La copia reusa la misma imagen, sin duplicarla. Solo se agrega.'
}

Table propuesta_al_recetario [headercolor: #8A6A12] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  receta_id uuid [not null, note: 'La receta propia que se propone.']
  version_de_receta_id uuid [not null, note: 'La versión que se propone.']
  profesional_id uuid [not null, note: 'Quien la propone, dueño de la receta.']
  medio_id uuid [note: 'La imagen, si la tiene.']
  version_de_la_cesion text [note: 'La versión del texto de la cesión aceptado.']
  huella_de_la_cesion text [note: 'El SHA-256 del texto aceptado.']
  momento_de_la_cesion timestamptz(3) [note: 'Cuándo se aceptó.']
  procedencia jsonb [not null, note: 'De dónde vino la fila.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (receta_id, momento_de_registro)
  }

  Note: 'Un profesional ofrece una versión de una receta suya. Con imagen, la cesión está completa; sin imagen, no hay cesión. Solo se agrega.'
}

Table decision_sobre_propuesta_al_recetario [headercolor: #8A6A12] {
  propuesta_id uuid [pk, note: 'La propuesta decidida, una sola vez.']
  resultado ResultadoDePropuestaAlRecetario [not null, note: 'Sumada o rechazada.']
  motivo text [note: 'Opcional, de 1 a 300 caracteres; lo ve quien la propuso.']
  administrador_id uuid [not null, note: 'Quién decidió, con su rol vigente.']
  procedencia jsonb [not null, note: 'De dónde vino la fila.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Lo que decide Administración. Sumada, con la receta ya en el recetario; rechazada, sin ella. Solo se agrega.'
}

// ─── Antropometría ────────────────────────────────────────────────────────────────────────────────

Table especificacion_antropometrica [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  clave text [not null, unique, note: 'Clave estable del protocolo o método.']
  tipo text [not null, note: 'Protocolo de toma o método de cálculo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Un protocolo de toma o un método de cálculo del catálogo, con clave estable.'
}

Table version_de_especificacion_antropometrica [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  especificacion_id uuid [not null, note: 'La especificación.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  version text [not null, note: 'Número de versión, correlativo dentro de su serie.']
  nombre text [not null, note: 'Nombre visible.']
  contenido jsonb [not null, note: 'Métricas, unidades admitidas, entradas requeridas y precisión declarada.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    especificacion_id
  }

  Note: 'Cada versión de un protocolo o método: métricas, unidades, entradas y precisión.'
}

Table retiro_de_especificacion [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  especificacion_id uuid [not null, unique, note: 'La especificación.']
  motivo text [not null, note: 'Motivo declarado.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El retiro de un protocolo o método: deja de ofrecerse, pero lo que lo usó sigue explicable.'
}

Table evaluacion_antropometrica [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  estado EstadoDeEvaluacionAntropometrica [not null, default: 'EN_PREPARACION', note: 'En preparación o registrada.']
  contexto text [note: 'Contexto de la toma.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_registro_de_evaluacion timestamptz(3) [note: 'Cuándo se registró la toma; vacío mientras está en preparación.']

  indexes {
    (asesorado_id, profesional_id, estado)
    (profesional_id, estado)
  }

  Note: 'Una toma antropométrica: se prepara, se registra y queda reconstruible.'
}

Table medicion_antropometrica [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  evaluacion_id uuid [not null, note: 'La evaluación a la que pertenece.']
  metrica text [not null, note: 'Qué se mide o calcula (por ejemplo, perímetro de cintura).']
  valor "numeric(12,4)" [not null, note: 'Valor numérico.']
  unidad_de_origen text [not null, note: 'Unidad tal como se tomó; nunca se convierte en silencio.']
  protocolo_version_id uuid [not null, note: 'La versión del protocolo con que se tomó.']
  origen OrigenDeMedicion [not null, note: 'Captura directa, autorreporte o importación controlada.']
  clase ClaseDeDato [not null, note: 'Medido, reportado o calculado.']
  referencia_de_preparacion text [note: 'Solo en importaciones: referencia de la preparación externa.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    evaluacion_id
    metrica
  }

  Note: 'Cada medición directa de una toma, con su unidad de origen y su protocolo.'
}

Table correccion_de_medicion [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  medicion_id uuid [not null, note: 'La medición.']
  correccion_previa_id uuid [unique, note: 'La corrección anterior de la cadena.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  motivo text [not null, note: 'Motivo declarado.']
  valor "numeric(12,4)" [not null, note: 'El valor corregido.']
  unidad_de_origen text [not null, note: 'Unidad tal como se tomó; nunca se convierte en silencio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    medicion_id
  }

  Note: 'La corrección de una medición, en cadena sobre la original, que no se toca.'
}

Table anulacion_de_medicion [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  medicion_id uuid [not null, unique, note: 'La medición.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  motivo text [not null, note: 'Motivo declarado.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La anulación de una medición. Es definitiva y solo puede haber una.'
}

Table ejecucion_de_calculo [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  evaluacion_id uuid [not null, note: 'La evaluación a la que pertenece.']
  metodo_version_id uuid [not null, note: 'La versión del método de cálculo.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  metrica text [not null, note: 'Qué se mide o calcula (por ejemplo, perímetro de cintura).']
  valor "numeric(12,4)" [not null, note: 'Valor numérico.']
  unidad text [not null, note: 'Unidad del valor.']
  decimales integer [not null, note: 'Cuántos decimales se informan.']
  modo_de_redondeo ModoDeRedondeo [not null, note: 'Cómo se redondea.']
  finalidad FinalidadDeCalculo [not null, note: 'Para qué se calculó; es parte de la identidad del cálculo.']
  regla text [not null, note: 'La regla de cálculo aplicada, identificada y versionada.']
  reemplaza_a_id uuid [unique, note: 'El cálculo al que reemplaza, si lo hay.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    evaluacion_id
  }

  Note: 'Cada cálculo derivado (por ejemplo, el porcentaje graso): método, versión, regla, precisión y resultado.'
}

Table entrada_de_calculo [headercolor: #9A4B2E] {
  ejecucion_id uuid [note: 'La sesión registrada o el cálculo al que pertenece.']
  medicion_id uuid [note: 'La medición.']
  metrica text [not null, note: 'Qué se mide o calcula (por ejemplo, perímetro de cintura).']
  valor "numeric(12,4)" [not null, note: 'El valor que usó el cálculo.']
  unidad text [not null, note: 'Unidad del valor.']

  indexes {
    (ejecucion_id, medicion_id) [pk]
    medicion_id
  }

  Note: 'Cada medición que usó un cálculo, declarada en forma explícita, con su valor y unidad.'
}

Table referencia_de_calculo [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  profesional_id uuid [not null, note: 'El profesional.']
  finalidad FinalidadDeCalculo [not null, note: 'Para qué se adopta la referencia.']
  ejecucion_id uuid [not null, note: 'La sesión registrada o el cálculo al que pertenece.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  fundamento text [note: 'Fundamento escrito por quien decide.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, profesional_id, finalidad)
    ejecucion_id
  }

  Note: 'El cálculo que el profesional adopta como referencia. Cambiarla crea una fila nueva.'
}

Table evento_de_antropometria [headercolor: #9A4B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeAntropometria [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  evaluacion_id uuid [note: 'La toma involucrada, si la hay.']
  medicion_id uuid [note: 'La medición involucrada, si la hay.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    evaluacion_id
    medicion_id
  }

  Note: 'Los hechos del área de Antropometría, en orden.'
}

// ─── Entrenamiento ────────────────────────────────────────────────────────────────────────────────

Table ejercicio_de_catalogo [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  procedencia ProcedenciaDeCatalogo [not null, note: 'Cómo entró al catálogo: semilla sintética de BE, carga de un profesional o importación revisada.']
  creado_por_id uuid [note: 'El profesional que lo cargó; vacío en el catálogo de base.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Un ejercicio del catálogo, con identificador estable. Su contenido vive en las versiones.'
}

Table version_de_ejercicio [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejercicio_id uuid [not null, note: 'El ejercicio.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  nombre text [not null, note: 'Nombre visible.']
  disponibilidad DisponibilidadDeElemento [not null, default: 'DISPONIBLE', note: 'Si se puede elegir para planes nuevos o está retirado.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ejercicio_id
  }

  Note: 'Cada versión de un ejercicio: nombre y disponibilidad.'
}

Table evaluacion_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  valoracion jsonb [not null, note: 'Lo evaluado por el profesional.']
  referencias jsonb [not null, note: 'Referencias que usó el profesional.']
  notas text [note: 'Las «Anotaciones» del profesional, hasta 4.000 caracteres: ninguna lectura de la persona las devuelve.']
  contexto text [note: 'Contexto de la evaluación.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, profesional_id, momento_de_registro)
  }

  Note: 'La evaluación de entrenamiento del profesional, con su contexto y referencias.'
}

Table cita_de_respuesta_en_evaluacion_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  evaluacion_id uuid [not null, note: 'La evaluación a la que pertenece.']
  respuesta_id uuid [not null, note: 'La respuesta.']
  rectificacion_id uuid [note: 'La rectificación citada, si se cita una.']
  codigo_de_campo text [not null, note: 'El campo del formulario citado.']
  orden integer [not null, note: 'Posición en la lista.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (evaluacion_id, orden) [unique]
    (evaluacion_id, respuesta_id, codigo_de_campo) [unique]
    respuesta_id
  }

  Note: 'Una respuesta de formulario citada como evidencia en una evaluación. Se cita, no se copia.'
}

Table objetivo_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id) [unique]
  }

  Note: 'El objetivo de entrenamiento de una persona con un profesional. Apunta a sus versiones.'
}

Table version_de_objetivo_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  objetivo_id uuid [not null, note: 'El objetivo.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  evaluacion_id uuid [not null, note: 'La evaluación en la que se apoya.']
  vigente_desde timestamptz(3) [not null, note: 'Desde cuándo vale.']
  vigente_hasta timestamptz(3) [note: 'Hasta cuándo valió; vacío si sigue vigente.']
  objetivo jsonb [not null, note: 'El objetivo, tal como lo define el profesional.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  revision_de_origen_id uuid [note: 'La revisión que la originó, si la hay.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    objetivo_id
  }

  Note: 'Cada versión del objetivo de entrenamiento, con su fundamento y su vigencia.'
}

Table plan_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  version_efectiva_id uuid [unique, note: 'La versión vigente del plan.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, asesorado_id) [unique]
  }

  Note: 'El plan de entrenamiento de una persona con un profesional. Apunta a la versión vigente.'
}

Table version_de_plan_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  plan_id uuid [not null, note: 'El plan al que pertenece.']
  predecesora_id uuid [note: 'La fila anterior de la cadena; vacía en la primera.']
  estado EstadoDeVersionDePlan [not null, default: 'BORRADOR', note: 'Borrador, activada o descartada.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  version_de_objetivo_id uuid [not null, note: 'La versión de objetivo a la que responde.']
  contenido jsonb [not null, note: 'Fases, semanas, sesiones, bloques y prescripciones, con identificadores estables. Puede declarar la notación del esfuerzo (RPE); lo guardado en cada serie es siempre el RIR.']
  proxima_revision date [note: 'Cuándo toca revisar esta versión.']
  revision_de_origen_id uuid [note: 'La revisión que la originó, si la hay.']
  autor_id uuid [not null, note: 'Quién escribió la versión (sin clave foránea).']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_activacion timestamptz(3) [note: 'Cuándo se activó.']
  origen_de_plantilla jsonb [note: 'De qué plantilla y versión salió este borrador, si salió de una.']

  indexes {
    plan_id
  }

  Note: 'Cada versión del plan: bloques, sesiones y prescripciones. Una versión activada no se modifica.'
}

Table instantanea_de_plan_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  version_de_plan_id uuid [not null, unique, note: 'La versión de plan.']
  contenido jsonb [not null, note: 'El plan tal como se emitió.']
  huella text [not null, note: 'Huella SHA-256 del contenido, para comprobar que no cambió.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Lo que se emitió al activar una versión, con su huella. La sesión registrada se lee contra esta instantánea, nunca contra un borrador ni contra el catálogo actual.'
}

Table borrador_de_ejecucion_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  version_de_plan_id uuid [not null, note: 'La versión de plan.']
  sesion_planificada_id text [not null, note: 'La sesión del plan a la que corresponde, por su identificador estable dentro del plan.']
  fecha_local date [not null, note: 'El día, según la zona horaria de la persona.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  granularidad GranularidadDeRegistro [note: 'Por serie, o por ejercicio o sesión. Se decide al editar.']
  condicion CondicionDeSesion [note: 'Realizada, realizada con desvío o no realizada.']
  motivo text [note: 'Motivo, si no se hizo completa.']
  contenido jsonb [not null, default: '{}', note: 'Lo cargado hasta ahora.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  version integer [not null, default: 1, note: 'Versión de la fila; cada escritura declara la que leyó.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (asesorado_id, version_de_plan_id, sesion_planificada_id, fecha_local) [unique]
  }

  Note: 'La sesión en curso: lo que la persona va cargando antes de confirmar.'
}

Table evento_de_tiempo_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  borrador_id uuid [not null, note: 'El borrador de la sesión en curso.']
  asesorado_id uuid [not null, note: 'La persona (sin clave foránea: la da el borrador).']
  corrida_id text [not null, note: 'La corrida del reloj en el teléfono.']
  secuencia integer [not null, note: 'Orden total de los hechos.']
  evento_id text [not null, note: 'Identificador del evento que generó el teléfono; evita duplicados.']
  tipo TipoDeEventoDeTiempo [not null, note: 'Inicio, pausa, reanudación, descanso, serie cronometrada, fin y otros.']
  contenido jsonb [not null, note: 'El evento tal como se validó.']
  instante_civil timestamptz(3) [not null, note: 'La hora del teléfono al ocurrir.']
  ancla_monotonica text [note: 'Referencia del reloj monotónico del teléfono.']
  ms_monotonicos "double precision" [note: 'Milisegundos del reloj monotónico, que no salta si cambia la hora.']
  base_del_reloj BaseDelReloj [note: 'Qué reloj se usó.']
  origen_del_instante OrigenDelInstante [not null, note: 'De dónde salió la hora.']
  descanso_recomendado_segundos integer [note: 'El descanso indicado en el plan, en segundos.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_recepcion timestamptz(3) [not null, default: `now()`, note: 'Cuándo lo recibió el servidor.']

  indexes {
    (borrador_id, secuencia) [unique]
    (borrador_id, evento_id) [unique]
    (asesorado_id, tipo)
  }

  Note: 'Cada evento de tiempo de la sesión en curso (inicio, descanso, pausa), con su reloj.'
}

Table ejecucion_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  version_de_plan_id uuid [not null, note: 'La versión de plan.']
  sesion_planificada_id text [not null, note: 'La sesión del plan a la que corresponde, por su identificador estable dentro del plan.']
  fecha_local date [not null, note: 'El día, según la zona horaria de la persona.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  borrador_id uuid [not null, unique, note: 'El borrador del que salió.']
  granularidad GranularidadDeRegistro [note: 'Por serie, o por ejercicio o sesión; vacía si la sesión no se hizo.']
  condicion CondicionDeSesion [not null, note: 'Realizada, realizada con desvío o no realizada.']
  motivo text [note: 'Motivo, si no se hizo completa.']
  contenido jsonb [not null, note: 'Lo que hizo: ejercicios, series, repeticiones, cargas y esfuerzo.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, version_de_plan_id, sesion_planificada_id, fecha_local) [unique]
    (asesorado_id, fecha_local)
  }

  Note: 'La sesión registrada y confirmada. Una sola por sesión planificada y por día, y no se edita.'
}

Table correccion_de_ejecucion_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejecucion_id uuid [not null, note: 'La sesión registrada o el cálculo al que pertenece.']
  correccion_previa_id uuid [unique, note: 'La corrección anterior de la cadena.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  motivo text [not null, note: 'Motivo declarado.']
  contenido jsonb [not null, note: 'La sesión corregida.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ejecucion_id
  }

  Note: 'La corrección de una sesión registrada, en cadena, con su autor real.'
}

Table nota_de_ejecucion [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejecucion_id uuid [not null, note: 'La sesión registrada a la que se refiere.']
  asesorado_id uuid [not null, note: 'La persona: la misma de la sesión.']
  texto text [not null, note: 'El texto de la nota, de hasta 280 caracteres.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (ejecucion_id, momento_de_registro)
    asesorado_id
  }

  Note: 'La nota que la persona deja en una sesión suya ya registrada, para su profesional. Va aparte de la sesión, que no cambia, y no se edita ni se borra.'
}

Table revision_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  proceso_id uuid [not null, note: 'El proceso de acompañamiento.']
  periodo_inicio date [not null, note: 'Primer día del período revisado.']
  periodo_fin date [not null, note: 'Último día del período revisado.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  evidencias jsonb [not null, note: 'Lo que el profesional miró para decidir (registros, tomas, respuestas).']
  interpretacion text [not null, note: 'Lo que el profesional interpreta de la evidencia.']
  resultado ResultadoDeRevision [not null, note: 'Mantener, ajustar, sustituir, reprogramar la revisión, cambiar el objetivo o finalizar.']
  fundamento text [not null, note: 'Fundamento escrito por quien decide.']
  proxima_accion jsonb [not null, note: 'Lo que sigue: próxima revisión, ajuste o cierre.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    proceso_id
  }

  Note: 'La revisión del profesional sobre un período de entrenamiento.'
}

Table aplicacion_de_revision_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  revision_id uuid [not null, unique, note: 'La revisión.']
  evento_id uuid [not null, unique, note: 'El hecho del proceso que deja la aplicación.']
  tipo TipoDeAplicacion [not null, note: 'Continuidad o cierre del proceso.']
  estado_de_proceso_posterior EstadoDeProceso [not null, note: 'Cómo queda el proceso.']
  version_de_plan_creada_id uuid [note: 'La versión de plan que creó, si creó una.']
  version_de_objetivo_creada_id uuid [note: 'La versión de objetivo que creó, si creó una.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Lo que se hizo con una revisión de entrenamiento: seguir, ajustar, sustituir o cerrar.'
}

Table evento_de_entrenamiento [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeEntrenamiento [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  profesional_id uuid [note: 'El profesional involucrado, si lo hay.']
  asesorado_id uuid [note: 'La persona involucrada, si la hay.']
  recurso_tipo text [not null, note: 'Tipo del recurso al que se refiere el hecho.']
  recurso_id uuid [not null, note: 'Identificador del recurso al que se refiere el hecho.']
  estado_previo text [note: 'Estado antes del hecho.']
  estado_posterior text [note: 'Estado después del hecho.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, momento_de_registro)
    recurso_id
  }

  Note: 'Los hechos del área de Entrenamiento, en orden.'
}

Table serie_observada [headercolor: #B0413E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  ejercicio_id uuid [not null, note: 'El ejercicio.']
  fecha_local date [not null, note: 'El día, según la zona horaria de la persona.']
  zona_horaria text [not null, note: 'Zona horaria de la persona al registrar (formato IANA).']
  carga "double precision" [note: 'La carga tal como se escribió, en su unidad (kg o lb, sin convertir); vacía en una anulación.']
  unidad text [note: 'La unidad de la carga: kg o lb.']
  repeticiones integer [note: 'Las repeticiones observadas; vacías en una anulación.']
  rir "double precision" [note: 'Las repeticiones en reserva (RIR), de 0 a 2; vacías en una anulación.']
  nota text [note: 'Una nota del profesional sobre la serie.']
  estimacion jsonb [note: 'La fuerza estimada, guardada como hecho: especificación, versión, método (Epley v1), banda, entradas y valor; vacía en una anulación.']
  tipo TipoDeSerieObservada [not null, default: 'OBSERVADA', note: 'Una serie observada o la anulación de la anterior.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  motivo text [note: 'Por qué se corrigió o se anuló; vacío en la primera de la cadena.']
  posicion integer [not null, default: 1, note: 'Lugar de la fila en su cadena de sucesiones; sirve de versión para detectar escrituras simultáneas.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, profesional_id, ejercicio_id, fecha_local)
  }

  Note: 'Cada serie que el profesional observó en un ejercicio de la persona (carga, repeticiones y RIR), con la fuerza estimada por Epley guardada como hecho. Corregir o anular agrega una fila que sucede a la anterior. La persona no la recibe.'
}

// ─── Catálogos e importación ──────────────────────────────────────────────────────────────────────

Table candidato_de_importacion [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  proveedor ProveedorExterno [not null, note: 'Proveedor externo del que viene.']
  id_externo text [not null, note: 'Identificador del ítem en el proveedor externo.']
  contenido jsonb [not null, note: 'Lo necesario para revisar: nombre y composición, o nombre, categoría y músculos.']
  huella_de_lo_recibido text [not null, note: 'Huella de la respuesta del proveedor, tal cual llegó.']
  licencia jsonb [not null, note: 'La licencia del dato externo.']
  url_de_origen text [not null, note: 'Dónde está el dato en el proveedor.']
  profesional_id uuid [not null, note: 'El profesional.']
  recibido_en timestamptz(3) [not null, note: 'Cuándo se recibió.']
  vence_en timestamptz(3) [not null, note: 'Cuándo deja de valer.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (profesional_id, momento_de_registro)
  }

  Note: 'Lo que devolvió un catálogo externo, listo para que el profesional lo revise, con su licencia y su huella.'
}

Table resolucion_de_candidato [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  candidato_id uuid [not null, unique, note: 'El candidato.']
  decision DecisionDeImportacion [not null, note: 'Importar o descartar.']
  contenido_revisado jsonb [note: 'Lo que el profesional dejó después de revisar.']
  campos_corregidos jsonb [not null, default: '[]', note: 'Qué campos corrigió.']
  fundamento text [note: 'Por qué decidió así, si lo dijo.']
  elemento_nutricional_id uuid [note: 'El alimento creado, si importó uno.']
  ejercicio_id uuid [note: 'El ejercicio creado, si importó uno.']
  version_creada_id uuid [note: 'La versión creada, si importó.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La decisión del profesional sobre un candidato: importarlo (con correcciones) o descartarlo.'
}

Table item_externo_de_catalogo [headercolor: #456B7F] {
  proveedor ProveedorExterno [note: 'Proveedor externo del que viene.']
  id_externo text [note: 'Identificador del ítem en el proveedor externo.']
  elemento_nutricional_id uuid [unique, note: 'El alimento, si el ítem es un alimento.']
  ejercicio_id uuid [unique, note: 'El ejercicio, si el ítem es un ejercicio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (proveedor, id_externo) [pk]
  }

  Note: 'Un ítem importado de un proveedor externo. Uno por proveedor e identificador, compartido entre profesionales.'
}

Table nombre_alternativo_de_alimento [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  elemento_id uuid [not null, note: 'El alimento.']
  nombre text [not null, note: 'Nombre visible.']
  idioma IdiomaDeNombre [not null, note: 'Idioma del nombre.']
  region text [note: 'País donde se usa el nombre (código ISO de dos letras); vacío si no es de uno en particular.']
  origen OrigenDeNombreAlternativo [not null, note: 'De dónde salió: del proveedor o de un profesional.']
  proveedor ProveedorExterno [note: 'Solo si salió de un proveedor.']
  profesional_id uuid [note: 'Quién lo agregó, si lo agregó un profesional.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    elemento_id
  }

  Note: 'Otro nombre con que se conoce un alimento (de otro país o en inglés), para encontrarlo.'
}

Table retiro_de_nombre_alternativo_de_alimento [headercolor: #456B7F] {
  nombre_id uuid [pk, note: 'El nombre alternativo.']
  motivo text [not null, note: 'Motivo declarado.']
  profesional_id uuid [note: 'Quién lo retiró.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El retiro de un nombre alternativo de alimento: queda en la historia y deja de buscarse.'
}

Table nombre_alternativo_de_ejercicio [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejercicio_id uuid [not null, note: 'El ejercicio.']
  nombre text [not null, note: 'Nombre visible.']
  idioma IdiomaDeNombre [not null, note: 'Idioma del nombre.']
  region text [note: 'País donde se usa el nombre (código ISO de dos letras); vacío si no es de uno en particular.']
  origen OrigenDeNombreAlternativo [not null, note: 'De dónde salió: del proveedor o de un profesional.']
  proveedor ProveedorExterno [note: 'Solo si salió de un proveedor.']
  profesional_id uuid [note: 'Quién lo agregó, si lo agregó un profesional.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    ejercicio_id
  }

  Note: 'Otro nombre con que se conoce un ejercicio, para encontrarlo.'
}

Table retiro_de_nombre_alternativo_de_ejercicio [headercolor: #456B7F] {
  nombre_id uuid [pk, note: 'El nombre alternativo.']
  motivo text [not null, note: 'Motivo declarado.']
  profesional_id uuid [note: 'Quién lo retiró.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El retiro de un nombre alternativo de ejercicio.'
}

Table asociacion_de_imagen_de_ejercicio [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejercicio_id uuid [not null, note: 'El ejercicio.']
  version_de_ejercicio_id uuid [not null, note: 'La versión del ejercicio a la que se asoció.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  cambio CambioDeImagenDeEjercicio [not null, note: 'Asociar o retirar; asociar otra reemplaza la vigente.']
  medio_id uuid [note: 'La imagen.']
  texto_alternativo text [note: 'Texto alternativo para lectores de pantalla.']
  licencia jsonb [note: 'Si la imagen es propia o tiene licencia externa (con su referencia).']
  revision_tecnica RevisionTecnicaDeImagen [note: 'Estado de la revisión técnica de la imagen.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (ejercicio_id, numero) [unique]
    medio_id
    version_de_ejercicio_id
  }

  Note: 'Cada cambio de la imagen de un ejercicio propio, con su licencia y su revisión técnica.'
}

Table zona_muscular [headercolor: #456B7F] {
  id text [pk, note: 'Identificador único de la fila.']
  nombre text [not null, note: 'Nombre visible.']
  vistas_anatomicas "VistaAnatomica[]" [not null, note: 'En qué vistas se dibuja: anterior, posterior o las dos.']
  version_del_catalogo text [not null, note: 'Versión del catálogo de zonas.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'El catálogo de las 17 zonas musculares que dibuja la figura del cuerpo.'
}

Table asignacion_de_zonas_de_ejercicio [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  ejercicio_id uuid [not null, note: 'El ejercicio.']
  version_de_ejercicio_id uuid [not null, note: 'La versión del ejercicio a la que se asignó.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  autor_id uuid [note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (ejercicio_id, numero) [unique]
    version_de_ejercicio_id
  }

  Note: 'Cada cambio de las zonas musculares de un ejercicio. La vigente es la de mayor número.'
}

Table zona_de_ejercicio [headercolor: #456B7F] {
  asignacion_id uuid [note: 'La asignación.']
  zona_id text [note: 'La zona muscular.']
  rol RolDeZonaMuscular [not null, note: 'Principal o secundario.']

  indexes {
    (asignacion_id, zona_id) [pk]
    zona_id
  }

  Note: 'Una zona dentro de una asignación, con su rol (principal o secundario).'
}

Table grupo_de_alimento [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  elemento_id uuid [not null, note: 'El alimento.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  grupo GrupoDeAlimento [not null, note: 'El grupo del alimento.']
  autor_id uuid [note: 'Quién lo eligió; NULL si lo sembró BE con una migración.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (elemento_id, numero) [unique]
  }

  Note: 'El grupo de un alimento, aparte de sus versiones: cambiarlo no crea una versión ni toca planes, recetas ni registros. El vigente es el de mayor número.'
}

Table alimento_compartido [headercolor: #456B7F] {
  elemento_id uuid [pk, note: 'El alimento.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Histórica: un alimento cargado a mano que veían los demás profesionales. Desde que lo cargado a mano es propio de quien lo cargó, no se escribe.'
}

Table alimento_del_canon [headercolor: #456B7F] {
  elemento_id uuid [pk, note: 'El alimento.']
  fuente text [not null, note: 'La tabla, la publicación o el rótulo de donde salen sus valores.']
  origen_id uuid [note: 'La carga a mano de cuyos valores partió, si partió de una.']
  administrador_id uuid [not null, note: 'La cuenta de Administración.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Un alimento que Administración sumó al catálogo verificado («Sumar al canon»), con su fuente y, si salió de una carga a mano, la carga de la que partió.'
}

Table medidas_caseras_de_alimento [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  elemento_id uuid [not null, note: 'El alimento.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  medidas jsonb [not null, note: 'Las medidas caseras, cada una con su equivalencia en gramos.']
  autor_id uuid [note: 'Quién las definió; NULL si las sembró BE con una migración.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (elemento_id, numero) [unique]
  }

  Note: 'Las medidas caseras de un alimento (la unidad, la cucharada, la taza y la porción), cada una con su equivalencia en gramos. Cada cambio es una versión nueva.'
}

Table revision_administrativa_de_alimento [headercolor: #456B7F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  elemento_id uuid [not null, note: 'El alimento.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  resultado ResultadoDeRevisionDeAlimento [not null, note: 'Mantener, ajustar, sustituir, reprogramar la revisión, cambiar el objetivo o finalizar.']
  version_id uuid [not null, note: 'La versión que vio y revisó.']
  fuente text [note: 'La fuente citada: solo y siempre en CERTIFICADO.']
  equivalente_id uuid [note: 'El alimento verificado equivalente: solo y siempre en EQUIVALENTE.']
  administrador_id uuid [not null, note: 'La cuenta de Administración.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (elemento_id, numero) [unique]
    equivalente_id
  }

  Note: 'Cada decisión de Administración sobre un alimento cargado a mano, contra la versión que vio: certificarlo con su fuente o marcar su equivalente verificado. La vigente es la de mayor número.'
}

// ─── Formularios y hábitos ────────────────────────────────────────────────────────────────────────

Table plantilla_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  clave text [not null, unique, note: 'Clave estable y legible.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'Un formulario del catálogo (salud, hábitos, inicio), con clave estable.'
}

Table version_de_plantilla_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  plantilla_id uuid [not null, note: 'La plantilla.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  version text [not null, note: 'Número de versión, correlativo dentro de su serie.']
  nombre text [not null, note: 'Nombre visible.']
  proposito text [not null, note: 'Para qué sirve el formulario.']
  dominio Alcance [note: 'El área a la que pertenece; vacío si sirve para las tres.']
  contenido jsonb [not null, note: 'Secciones y campos, con tipo, unidad, categoría y ayuda.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    plantilla_id
  }

  Note: 'Cada versión de un formulario: secciones, campos, tipos y ayudas.'
}

Table solicitud_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  vinculo_id uuid [not null, note: 'El vínculo desde el que se pide.']
  template_version_id uuid [not null, note: 'La versión del formulario que se pide.']
  proposito text [not null, note: 'Para qué lo pide el profesional.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  campos_solicitados jsonb [not null, note: 'Los campos que se piden.']
  campos_requeridos jsonb [not null, note: 'Los campos obligatorios, dentro de los pedidos.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, profesional_id, momento_de_registro)
    vinculo_id
  }

  Note: 'El pedido de un profesional a una persona para que complete un formulario.'
}

Table propuesta_de_respuesta_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  solicitud_id uuid [not null, note: 'La solicitud de formulario.']
  profesional_id uuid [not null, note: 'El profesional.']
  contenido jsonb [note: 'Las respuestas propuestas mientras está pendiente; vacío después.']
  estado EstadoDePropuestaDeRespuesta [not null, default: 'PENDIENTE', note: 'Pendiente, confirmada, rechazada o retirada.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  cargada_en timestamptz(3) [not null, default: `now()`, note: 'Cuándo se cargó por última vez.']
  resuelta_en timestamptz(3) [note: 'Cuándo se resolvió.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    solicitud_id
    profesional_id
  }

  Note: 'Lo que el profesional cargó con lo que la persona le contó, a la espera de que ella lo confirme.'
}

Table respuesta_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  solicitud_id uuid [not null, unique, note: 'La solicitud de formulario.']
  asesorado_id uuid [not null, note: 'La persona.']
  template_version_id uuid [not null, note: 'La versión del formulario respondida.']
  contenido jsonb [not null, note: 'Las respuestas por campo, declaradas por la persona.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  transcripcion jsonb [note: 'Si nació de una propuesta del profesional: quién la cargó, cuándo se confirmó y qué corrigió la persona.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  Note: 'La respuesta de la persona. No se sobrescribe.'
}

Table rectificacion_de_respuesta_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  respuesta_id uuid [not null, note: 'La respuesta.']
  correccion_previa_id uuid [unique, note: 'La rectificación anterior de la cadena.']
  motivo text [not null, note: 'Motivo declarado.']
  contenido jsonb [not null, note: 'Las respuestas rectificadas.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  version integer [not null, note: 'Número de versión, correlativo dentro de su serie.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    respuesta_id
  }

  Note: 'Una rectificación de la respuesta, en cadena, sin tocar la original.'
}

Table evento_de_formulario [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  secuencia bigint [not null, unique, increment, note: 'Orden total de los hechos.']
  tipo TipoDeEventoDeFormulario [not null, note: 'Qué hecho ocurrió (los valores posibles están en el anexo de conjuntos de valores).']
  profesional_id uuid [note: 'El profesional involucrado, si lo hay.']
  asesorado_id uuid [note: 'La persona involucrada, si la hay.']
  recurso_tipo text [not null, note: 'Tipo del recurso al que se refiere el hecho.']
  recurso_id uuid [not null, note: 'Identificador del recurso al que se refiere el hecho.']
  estado_previo text [note: 'Estado antes del hecho.']
  estado_posterior text [note: 'Estado después del hecho.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, momento_de_registro)
    recurso_id
  }

  Note: 'Los hechos de los formularios, en orden.'
}

Table habitos_de_la_persona [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  version integer [not null, note: 'Número de versión, correlativo dentro de su serie.']
  contenido jsonb [not null, note: 'Las respuestas de «Tus hábitos».']
  origen OrigenDeHabitos [not null, note: 'Desde un formulario o desde «Mis hábitos».']
  respuesta_de_formulario_id uuid [note: 'La respuesta de formulario de la que salieron, si salieron de una.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, version) [unique]
    respuesta_de_formulario_id
  }

  Note: 'Los hábitos de la persona, que son de ella y no de un área. Cada cambio es una versión nueva.'
}

Table autorizacion_de_habitos [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  version integer [not null, note: 'Número de versión, correlativo dentro de su serie.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  estado EstadoDeAutorizacionDeHabitos [not null, note: 'Activa o retirada.']
  version_de_texto_id text [note: 'El texto que se aceptó.']
  hash_del_texto text [note: 'Huella SHA-256 del texto aceptado.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, version) [unique]
    version_de_texto_id
  }

  Note: 'La autorización de la persona para que los profesionales que elige vean sus hábitos.'
}

Table destinatario_de_habitos [headercolor: #6B5B2E] {
  autorizacion_id uuid [note: 'La autorización a la que pertenece.']
  alcance_de_vinculo_id uuid [note: 'El área del vínculo.']
  profesional_id uuid [not null, note: 'El profesional.']
  estado EstadoDeDestinatarioDeHabitos [not null, note: 'Si recibe los hábitos o no.']
  incluido_desde timestamptz(3) [note: 'Desde cuándo los recibe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (autorizacion_id, alcance_de_vinculo_id) [pk]
    profesional_id
    alcance_de_vinculo_id
  }

  Note: 'Cada profesional que recibe los hábitos según una autorización.'
}

Table pedido_de_acceso_a_habitos [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  alcance_de_vinculo_id uuid [not null, note: 'El área del vínculo.']
  alcance Alcance [not null, note: 'El área desde la que pide.']
  estado EstadoDePedidoDeAccesoAHabitos [not null, default: 'PENDIENTE', note: 'Pendiente, aceptado, «no por ahora» o reemplazado.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  pedido_en timestamptz(3) [not null, note: 'Cuándo se pidió.']
  resuelto_en timestamptz(3) [note: 'Cuándo se resolvió; vacío mientras está pendiente.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, estado)
    (profesional_id, asesorado_id)
    alcance_de_vinculo_id
  }

  Note: 'El pedido de un profesional para ver los hábitos de la persona.'
}

Table vinculo_de_formulario_en_evaluacion [headercolor: #6B5B2E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  alcance Alcance [not null, note: 'NUTRICION o ENTRENAMIENTO: dice cuál de las dos evaluaciones lleva (la otra es NULL).']
  evaluacion_nutricional_id uuid [note: 'La evaluación de Nutrición, si el vínculo es de esa área.']
  evaluacion_de_entrenamiento_id uuid [note: 'La evaluación de Entrenamiento, si el vínculo es de esa área.']
  respuesta_id uuid [not null, note: 'La respuesta.']
  rectificacion_id uuid [note: 'La rectificación vigente al vincular; `null` si lo vigente era la respuesta original.']
  vinculado_en timestamptz(3) [not null, default: `now()`, note: 'Cuándo se vinculó.']
  desvinculado_en timestamptz(3) [note: 'Cuándo se desvinculó; vacío mientras sigue vinculado.']

  indexes {
    (evaluacion_nutricional_id, vinculado_en)
    (evaluacion_de_entrenamiento_id, vinculado_en)
    respuesta_id
    rectificacion_id
  }

  Note: 'Un formulario que la persona respondió, vinculado entero a una evaluación inicial de Nutrición o de Entrenamiento. Es una referencia, no una copia.'
}

// ─── Lo que se comparte entre áreas ───────────────────────────────────────────────────────────────

Table autorizacion_de_resumenes [headercolor: #7B3F6E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  version integer [not null, note: 'Número de versión, correlativo dentro de su serie.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  estado EstadoDeAutorizacionDeResumenes [not null, note: 'Activa o retirada.']
  version_de_texto_id text [note: 'El texto que se aceptó.']
  hash_del_texto text [note: 'Huella SHA-256 del texto aceptado.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, version) [unique]
    version_de_texto_id
  }

  Note: 'La autorización de la persona para que un profesional vea lo de otras áreas, con un nivel.'
}

Table texto_aceptado_de_resumenes [headercolor: #7B3F6E] {
  autorizacion_id uuid [note: 'La autorización a la que pertenece.']
  nivel NivelDeResumenCompartido [note: 'Resumen, o resumen y plan.']
  version_de_texto_id text [not null, note: 'El texto que se aceptó.']
  hash_del_texto text [not null, note: 'Huella SHA-256 del texto aceptado.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (autorizacion_id, nivel) [pk]
    version_de_texto_id
  }

  Note: 'El texto aceptado para cada nivel de lo que se comparte, con su huella.'
}

Table destinatario_de_resumenes [headercolor: #7B3F6E] {
  autorizacion_id uuid [note: 'La autorización a la que pertenece.']
  alcance_de_vinculo_id uuid [note: 'El área del vínculo.']
  origen_id uuid [note: 'El componente de vínculo del área de origen.']
  profesional_id uuid [not null, note: 'El profesional.']
  area Alcance [not null, note: 'El área de origen de lo que se comparte.']
  nivel NivelDeResumenCompartido [not null, note: 'Qué ve: el resumen, o el resumen y el plan.']
  nivel_desde timestamptz(3) [not null, note: 'Desde cuándo vale ese nivel.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (autorizacion_id, alcance_de_vinculo_id, origen_id) [pk]
    profesional_id
    alcance_de_vinculo_id
    origen_id
  }

  Note: 'Quién recibe qué: el profesional, el área de origen y el nivel.'
}

Table pedido_de_acceso_a_plan [headercolor: #7B3F6E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  asesorado_id uuid [not null, note: 'La persona.']
  alcance_de_vinculo_id uuid [not null, note: 'El área del vínculo.']
  alcance Alcance [not null, note: 'El área desde la que pide.']
  area Alcance [not null, note: 'El área cuyo plan pide ver (otra, con plan).']
  estado EstadoDePedidoDeAccesoAPlan [not null, default: 'PENDIENTE', note: 'Pendiente, aceptado, «no por ahora» o reemplazado.']
  version integer [not null, default: 1, note: 'Número de versión, correlativo dentro de su serie.']
  pedido_en timestamptz(3) [not null, note: 'Cuándo se pidió.']
  resuelto_en timestamptz(3) [note: 'Cuándo se resolvió; vacío mientras está pendiente.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, estado)
    (profesional_id, asesorado_id, area)
    alcance_de_vinculo_id
  }

  Note: 'El pedido de un profesional para ver el plan de otra área de la persona.'
}

Table nota_de_coordinacion [headercolor: #7B3F6E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  asesorado_id uuid [not null, note: 'La persona.']
  alcance_de_origen Alcance [not null, note: 'El área desde la que escribe el autor.']
  finalidad FinalidadDeNotaDeCoordinacion [not null, note: 'Para qué es la nota.']
  modo_de_destinatarios ModoDeDestinatariosDeNota [not null, note: 'Para todos los profesionales de la persona o para uno.']
  texto text [not null, note: 'Hasta 600 caracteres, sin adjuntos.']
  corrige_a_id uuid [note: 'La nota a la que corrige, si corrige una.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (asesorado_id, momento_de_registro, id)
    autor_id
    corrige_a_id
  }

  Note: 'Una nota breve entre los profesionales de una persona, escrita desde un área.'
}

Table destinatario_de_nota [headercolor: #7B3F6E] {
  nota_id uuid [note: 'La nota.']
  destinatario_id uuid [note: 'El profesional que la recibió.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (nota_id, destinatario_id) [pk]
    destinatario_id
  }

  Note: 'Los profesionales que recibieron una nota, fijados al escribirla.'
}

Table referencia_de_nota [headercolor: #7B3F6E] {
  nota_id uuid [note: 'La nota.']
  orden integer [note: 'Posición en la lista.']
  tipo TipoDeReferenciaDeNota [not null, note: 'Qué recurso se cita.']
  recurso_id uuid [not null, note: 'Identificador del recurso al que se refiere el hecho.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (nota_id, orden) [pk]
    (nota_id, tipo, recurso_id) [unique]
  }

  Note: 'Un recurso citado en una nota, por su identificador. Citarlo no da acceso.'
}

Table autorizacion_de_historia_anterior [headercolor: #7B3F6E] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  asesorado_id uuid [not null, note: 'La persona.']
  profesional_id uuid [not null, note: 'El profesional.']
  alcance Alcance [not null, note: 'Área: Nutrición, Entrenamiento o Antropometría.']
  alcance_de_vinculo_id uuid [not null, note: 'El área del vínculo.']
  version integer [not null, note: 'Número de versión, correlativo dentro de su serie.']
  predecesora_id uuid [unique, note: 'La fila anterior de la cadena; vacía en la primera.']
  estado EstadoDeAutorizacionDeHistoriaAnterior [not null, note: 'Borrador, activada o descartada.']
  texto_id text [note: 'El texto aceptado (`TEXTO_DE_LA_HISTORIA_ANTERIOR` de @be/domain) y su hash; solo en una VIGENTE.']
  hash_del_texto text [note: 'Huella SHA-256 del texto aceptado.']
  actor_id uuid [not null, note: 'Quién hizo la acción.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_ocurrencia timestamptz(3) [not null, note: 'Cuándo pasó el hecho en la realidad; vacío si no se sabe.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (alcance_de_vinculo_id, version) [unique]
    asesorado_id
  }

  Note: 'La autorización de la persona para que el profesional nuevo de un área vea lo que pasó antes en esa área, en solo lectura y sin las notas privadas. Se puede retirar; cada cambio es una versión.'
}

// ─── Herramientas del profesional ─────────────────────────────────────────────────────────────────

Table plantilla_de_plan_de_entrenamiento [headercolor: #3B6E8F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  profesional_id uuid [not null, note: 'El profesional.']
  nombre text [not null, note: 'Nombre visible.']
  nombre_normalizado text [not null, note: 'El nombre en minúsculas y sin tildes; con él se evita que se repita.']
  descripcion text [note: 'Descripción, si la hay.']
  estado EstadoDePlantilla [not null, default: 'ACTIVA', note: 'Activa o archivada.']
  version integer [not null, default: 1, note: 'Versión de la fila; cada escritura declara la que leyó.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']
  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (profesional_id, nombre_normalizado) [unique]
    (profesional_id, estado, momento_de_actualizacion)
  }

  Note: 'Un molde de plan de entrenamiento del profesional, sin datos de ninguna persona.'
}

Table version_de_plantilla_de_plan_de_entrenamiento [headercolor: #3B6E8F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
  plantilla_id uuid [not null, note: 'La plantilla.']
  numero integer [not null, note: 'Número correlativo dentro de su serie; la fila vigente es la de mayor número.']
  estructura jsonb [not null, note: 'La estructura del molde (días, comidas o sesiones), sin datos de ninguna persona.']
  cargas CargasDePlantilla [not null, default: 'NO_COPIADAS', note: 'Si el molde copió las cargas o las deja para cada persona.']
  origen jsonb [note: 'El plan del que se armó, si salió de uno.']
  autor_id uuid [not null, note: 'Quién hizo el cambio.']
  procedencia jsonb [not null, note: 'De dónde vino la fila: la fuente, la superficie (app o website), la operación, el caso de uso y el pedido que la produjo.']
  momento_de_registro timestamptz(3) [not null, default: `now()`, note: 'Cuándo BE guardó la fila.']

  indexes {
    (plantilla_id, numero) [unique]
  }

  Note: 'Cada versión de un molde de plan de entrenamiento.'
}

