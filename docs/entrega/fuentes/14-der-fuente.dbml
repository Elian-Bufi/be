  momento_de_actualizacion timestamptz(3) [not null, default: `now()`, note: 'Última modificación de la fila.']

  indexes {
    (profesional_id, momento_de_actualizacion)
  }

  Note: 'Un enfoque: un conjunto de hasta seis gráficos con nombre, propio del profesional y reutilizable con cualquier persona. Guarda solo referencias, nunca datos de una persona.'
}

Table eleccion_de_conjunto_de_graficos [headercolor: #3B6E8F] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identificador único de la fila.']
