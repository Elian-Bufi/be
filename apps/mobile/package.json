{
  "name": "@be/mobile",
  "version": "0.8.0",
  "private": true,
  "description": "App BE — Expo / React Native (APK por EAS, distribución directa)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build:apk:test": "eas build --platform android --profile test --non-interactive",
    "eas-build-post-install": "cd ../.. && npm run build:domain"
  },
  "dependencies": {
    "@be/domain": "0.1.0",
    "expo": "57.0.23",
    "expo-constants": "57.0.18",
    "expo-crypto": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
