  },
  "build": {
    "test": {
      "distribution": "internal",
      "node": "22.23.2",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "test",
        "API_BASE_URL": "https://be-api-hndp.onrender.com"
      }
    },
    "production": {
      "distribution": "internal",
      "node": "22.23.2",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  }
}
