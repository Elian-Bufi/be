// BE — schema físico derivado de BE-LEG-06 v0.1.1.
//
// Reglas que gobiernan este archivo:
//  1. Los nombres salen del 06 (y del 08 cuando el 06 no modela el concepto). Modelo = término sin sufijos de
//     implementación (CONV-06-01). Transliteración ASCII de tildes (TEN-40).
//  2. Los estados son enums con transiciones declaradas (CONV-06-02/03), nunca booleanos. La lista blanca vive en
//     @be/domain y además la base la exige con triggers (migración 20260918200000_identidad_y_sesiones).
//  3. Toda entidad que registre un hecho lleva el par momentoDeOcurrencia / momentoDeRegistro (T-06-24, REG-06-18).
//     Ocurrencia desconocida = NULL; nunca se copia el registro.
//  4. Historia por adición: las tablas de hechos son append-only (triggers). Sin ON DELETE CASCADE (08 §17).
//
// WP-01: Identidad. WP-02: perfil propio, método de acceso, credencial, sesiones, actos A1/A2/A3, eventos,
// auditoría, idempotencia, cierre y supresión (docs/paquetes/WP-02.md).
// WP-03: perfil profesional, verificación y habilitación mínimas; solicitud, vínculo por alcance, consentimiento B2
// versionado; eventos de M-02 y M-03; decisiones de acceso del PDP (docs/paquetes/WP-03.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────────────────────

/// T-06-02 — Estado operativo de cuenta (06 §5.7.2). Conjunto cerrado.
/// Inicial: OPERATIVA. Terminal: CERRADA. Transiciones: 06 §5.7.4 (@be/domain + trigger).
enum EstadoOperativoDeCuenta {
  OPERATIVA
  SUSPENDIDA
  CERRADA
}

/// T-06-03 — tipo de método de acceso. WP-02 solo implementa LOCAL (RF-003 federado fuera de alcance).
enum TipoDeMetodoDeAcceso {
  LOCAL
}

/// Estado de sesión — infraestructura (06:1839 no la define). Lista blanca: ACTIVA → FINALIZADA | REVOCADA.
enum EstadoDeSesion {
  ACTIVA
  FINALIZADA
  REVOCADA
}

/// 08 §26.3 — eventos que revocan sesiones.
enum MotivoDeRevocacionDeSesion {
  REVOCACION_POR_TITULAR
  CIERRE_DE_CUENTA
  SUSPENSION_DE_CUENTA
}

/// 08 §12.2 «canal/superficie», declarado por el cliente (DEUDA_LEGAJO DL-022).
enum Superficie {
  WEB
  APK
}

/// Tipo de versión de texto mostrado al titular (08 §12.2: versión mostrada = versión aceptada).
enum TipoDeTexto {
  TERMINOS
  PRIVACIDAD_INFO
  DATOS_SALUD_BE
  CONSECUENCIAS_DE_CIERRE
  /// B2 por perfil profesional (08 §12.3). WP-03.
  CONSENTIMIENTO_PROFESIONAL_SANITARIO
  CONSENTIMIENTO_PROFESIONAL_NO_SANITARIO
}

/// 08 §12.4 — actos registrables tipificados de la Relación A (A1, A2, A3).
enum TipoDeActoRegistrable {
  TERMINOS
  PRIVACIDAD_INFO
  DATOS_SALUD_BE
}

/// 08 §12.2 «estado (VIGENTE/REVOCADO)». Única transición: VIGENTE → REVOCADO, solo para tipos revocables.
enum EstadoDeActoRegistrable {
  VIGENTE
  REVOCADO
}

/// T-06-N08 — eventos de dominio de M-01 (06 §5.13) y revocación de actos. Hechos consumados (CONV-06-05).
enum TipoDeEventoDeDominio {
  IdentidadCreada
  MetodoDeAccesoAsociado
  CuentaSuspendida
  CuentaRestablecida
  CuentaCerrada
  ActoRevocado
  /// WP-03: otorgamiento o reotorgamiento de A3 (API-CON-06).
  ActoOtorgado
}

/// Resultado registrado en auditoría (08 §29).
enum ResultadoDeOperacion {
  EXITO
  RECHAZO
}

// ─── M-01 · Identidad (06 §5) ───────────────────────────────────────────────────────────────────

/// T-06-01 — Identidad BE (06 §5.4). Entidad longitudinal estable.
model Identidad {
  /// Identificador de dominio: estable, único, no reutilizable y no autonumérico (06 §5.4.2, T-06-N04).
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 06 §5.4.2 — exactamente un estado de la máquina T-06-02.
  estadoOperativoDeCuenta EstadoOperativoDeCuenta @default(OPERATIVA) @map("estado_operativo_de_cuenta")
  /// 06 §5.4.2 «autoría de creación: quién confirmó/produjo el alta». En autorregistro, la propia identidad.
  autoriaDeCreacionId     String                  @map("autoria_de_creacion_id") @db.Uuid
  /// T-06-23 / 06 §5.4.2 «procedencia: origen funcional del alta».
  procedencia             Json
  /// T-06-24 — cuándo se confirmó el alta. NULL si es desconocido (REG-06-18).
  momentoDeOcurrencia     DateTime?               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  /// T-06-24 — cuándo BE registró el alta.
  momentoDeRegistro       DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  perfilPropio              PerfilPropio?
  metodosDeAcceso           MetodoDeAcceso[]
  sesiones                  Sesion[]
  controlDeSesion           ControlDeSesion?
  actos                     ActoRegistrable[]
  eventos                   EventoDeDominio[]
  solicitudDeCierreDeCuenta SolicitudDeCierreDeCuenta?

  // WP-03
  perfilProfesional          PerfilProfesional?
  verificaciones             VerificacionProfesional[]
  habilitaciones             Habilitacion[]
  eventosDeVerificacion      EventoDeVerificacion[]
  solicitudesComoProfesional SolicitudDeVinculo[]      @relation("SolicitudDelProfesional")
  solicitudesComoAsesorado   SolicitudDeVinculo[]      @relation("SolicitudAlAsesorado")
  vinculosComoProfesional    Vinculo[]                 @relation("VinculoDelProfesional")
  vinculosComoAsesorado      Vinculo[]                 @relation("VinculoDelAsesorado")
  eventosComoProfesional     EventoDeVinculo[]         @relation("EventoDelProfesional")
  eventosComoAsesorado       EventoDeVinculo[]         @relation("EventoDelAsesorado")
  decisionesComoActor        DecisionDeAcceso[]        @relation("DecisionDelActor")
  decisionesComoSujeto       DecisionDeAcceso[]        @relation("DecisionSobreElSujeto")

  // WP-04
  capacidades                                CapacidadProfesional[]
  evaluacionesAntropometricasComoProfesional EvaluacionAntropometrica[]             @relation("EvaluacionAntropometricaDelProfesional")
  evaluacionesAntropometricasComoAsesorado   EvaluacionAntropometrica[]             @relation("EvaluacionAntropometricaDelAsesorado")
  medicionesCorregidas                       CorreccionDeMedicion[]                 @relation("CorreccionDeMedicionDelAutor")
  medicionesAnuladas                         AnulacionDeMedicion[]                  @relation("AnulacionDeMedicionDelAutor")
  ejecucionesDeCalculo                       EjecucionDeCalculo[]                   @relation("EjecucionDeCalculoDelAutor")
  referenciasDeCalculoComoAsesorado          ReferenciaDeCalculo[]                  @relation("ReferenciaDeCalculoDelAsesorado")
  referenciasDeCalculoComoProfesional        ReferenciaDeCalculo[]                  @relation("ReferenciaDeCalculoDelProfesional")
  procesosComoProfesional                    ProcesoOperativo[]                     @relation("ProcesoDelProfesional")
  procesosComoAsesorado                      ProcesoOperativo[]                     @relation("ProcesoDelAsesorado")
  evaluacionesComoProfesional                EvaluacionNutricional[]                @relation("EvaluacionDelProfesional")
  evaluacionesComoAsesorado                  EvaluacionNutricional[]                @relation("EvaluacionDelAsesorado")
  objetivosComoProfesional                   ObjetivoNutricional[]                  @relation("ObjetivoDelProfesional")
  objetivosComoAsesorado                     ObjetivoNutricional[]                  @relation("ObjetivoDelAsesorado")
  planesComoProfesional                      PlanNutricional[]                      @relation("PlanDelProfesional")
  planesComoAsesorado                        PlanNutricional[]                      @relation("PlanDelAsesorado")
  ingestas                                   IngestaNutricional[]                   @relation("IngestaDelAsesorado")
  ejerciciosCreados                          EjercicioDeCatalogo[]                  @relation("EjercicioCreadoPor")
  evaluacionesDeEntrenamientoComoProfesional EvaluacionDeEntrenamiento[]            @relation("EvaluacionDeEntrenamientoDelProfesional")
  evaluacionesDeEntrenamientoComoAsesorado   EvaluacionDeEntrenamiento[]            @relation("EvaluacionDeEntrenamientoDelAsesorado")
  objetivosDeEntrenamientoComoProfesional    ObjetivoDeEntrenamiento[]              @relation("ObjetivoDeEntrenamientoDelProfesional")
  objetivosDeEntrenamientoComoAsesorado      ObjetivoDeEntrenamiento[]              @relation("ObjetivoDeEntrenamientoDelAsesorado")
  planesDeEntrenamientoComoProfesional       PlanDeEntrenamiento[]                  @relation("PlanDeEntrenamientoDelProfesional")
  planesDeEntrenamientoComoAsesorado         PlanDeEntrenamiento[]                  @relation("PlanDeEntrenamientoDelAsesorado")
  borradoresDeEjecucion                      BorradorDeEjecucionDeEntrenamiento[]   @relation("BorradorDeEjecucionDelAsesorado")
  ejecucionesDeEntrenamiento                 EjecucionDeEntrenamiento[]             @relation("EjecucionDeEntrenamientoDelAsesorado")
  correccionesDeEjecucion                    CorreccionDeEjecucionDeEntrenamiento[] @relation("CorreccionDeEjecucionDelAutor")

  @@map("identidad")
}

/// T-06-04 — Perfil propio (06 §5.5). Exactamente uno por Identidad tras el alta (INV-06-22).
/// Sin contenido ni versiones mientras 04/05 no aprueben campos (DEUDA_LEGAJO DL-009).
model PerfilPropio {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId         String    @unique @map("identidad_id") @db.Uuid
  /// 06 §5.5.2 «referencia a Versión efectiva de perfil: exactamente una cuando existe contenido confirmado». NULL: sin contenido.
  versionEfectivaId   String?   @map("version_efectiva_id") @db.Uuid
  momentoDeOcurrencia DateTime? @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@map("perfil_propio")
}

/// T-06-03 — Método de acceso (06 §5.6). Identidad 1 : 0..N; un método vigente → como máximo 1 Identidad (INV-06-24).
/// La unicidad (tipo, referencia) es global e incluye cuentas cerradas (DEUDA_LEGAJO DL-011).
model MetodoDeAcceso {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId         String               @map("identidad_id") @db.Uuid
  tipo                TipoDeMetodoDeAcceso
  /// Identificador local normalizado (correo en minúsculas). Dato C3 (08 §4).
  referencia          String
  procedencia         Json
  momentoDeOcurrencia DateTime?            @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime             @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad       Identidad        @relation(fields: [identidadId], references: [id], onDelete: Restrict)
  credencialLocal CredencialLocal?

  /// D3 de WP-02: dos registros concurrentes con el mismo correo no crean dos identidades.
  @@unique([tipo, referencia])
  @@index([identidadId])
  @@map("metodo_de_acceso")
}

/// Credencial del método LOCAL (08 §24.2: hash adaptativo, nunca en claro). Dato C5.
/// Se suprime al cierre (08 R-02), con registro en RegistroDeSupresion (DEUDA_LEGAJO DL-019).
model CredencialLocal {
  metodoDeAccesoId  String   @id @map("metodo_de_acceso_id") @db.Uuid
  hash              String
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  metodoDeAcceso MetodoDeAcceso @relation(fields: [metodoDeAccesoId], references: [id], onDelete: Restrict)

  @@map("credencial_local")
}

// ─── Sesiones (07 §43-bis opción A+B; 08 §26) ──────────────────────────────────────────────────

/// Sesión revocable server-side (08 §26.1). El token nunca se persiste: solo su id (`sid`).
model Sesion {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId           String                      @map("identidad_id") @db.Uuid
  estado                EstadoDeSesion              @default(ACTIVA)
  superficie            Superficie?
  /// Momento de autenticación (ocurrencia). Base del step-up por sesión reciente (DL-017).
  momentoDeOcurrencia   DateTime                    @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro     DateTime                    @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  expiraEn              DateTime                    @map("expira_en") @db.Timestamptz(3)
  /// `ControlDeSesion.version` vigente al emitir; si cambia, la sesión deja de autenticar (tokenVersion, 07:1795).
  versionDeControl      Int                         @map("version_de_control")
  momentoDeFinalizacion DateTime?                   @map("momento_de_finalizacion") @db.Timestamptz(3)
  motivoDeRevocacion    MotivoDeRevocacionDeSesion? @map("motivo_de_revocacion")

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@index([identidadId, estado])
  @@map("sesion")
}

/// tokenVersion por cuenta (07:1795 «refuerzo barato»). Separado de Identidad para no agregarle campos ajenos al 06.
model ControlDeSesion {
  identidadId String @id @map("identidad_id") @db.Uuid
  version     Int    @default(0)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@map("control_de_sesion")
}

// ─── Relación A: actos A1/A2/A3 (08 §12) ───────────────────────────────────────────────────────

/// Versión de texto mostrada al titular. Catálogo inmutable sembrado por migración desde @be/domain (DL-028).
model VersionDeTexto {
  id                String      @id
  tipo              TipoDeTexto
  titulo            String
  finalidad         String
  texto             String
  /// SHA-256 hex del texto UTF-8 (08 §12.2).
  hash              String
  vigenteDesde      DateTime    @map("vigente_desde") @db.Timestamptz(3)
  momentoDeRegistro DateTime    @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  /// WP-03 · sucesión explícita: la versión a la que esta reemplaza. Como máximo una sucesora por versión (REG-06-12).
  /// La versión aplicable de B2 es la cabeza de la cadena de su tipo, no la más reciente por fecha (06:1286-1288; DL-038).
  reemplazaAId      String?     @unique @map("reemplaza_a_id")

  reemplazaA                VersionDeTexto?             @relation("SucesionDeTexto", fields: [reemplazaAId], references: [id], onDelete: Restrict)
  sucesora                  VersionDeTexto?             @relation("SucesionDeTexto")
  actos                     ActoRegistrable[]
  solicitudes               SolicitudDeCierreDeCuenta[]
  versionesDeConsentimiento VersionDeConsentimiento[]

  @@map("version_de_texto")
}

/// Acto registrable con la evidencia mínima del 08 §12.2. Inmutable salvo VIGENTE → REVOCADO (trigger).
model ActoRegistrable {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Titular (08 §12.2 «quién»).
  identidadId         String                  @map("identidad_id") @db.Uuid
  tipo                TipoDeActoRegistrable
  estado              EstadoDeActoRegistrable @default(VIGENTE)
  /// Versión mostrada = versión aceptada (08 §12.2), con su hash copiado como evidencia.
  versionDeTextoId    String                  @map("version_de_texto_id")
  hashDelTexto        String                  @map("hash_del_texto")
  finalidad           String
  superficie          Superficie?
  /// Evidencia técnica del acto (08 §12.2), datos C3 con retención R-06.
  direccionIp         String?                 @map("direccion_ip")
  agenteDeUsuario     String?                 @map("agente_de_usuario")
  /// REG-06-17: actor ≠ autoría ≠ procedencia.
  actorId             String                  @map("actor_id") @db.Uuid
  autoriaId           String                  @map("autoria_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime                @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeRevocacion DateTime?               @map("momento_de_revocacion") @db.Timestamptz(3)

  identidad      Identidad      @relation(fields: [identidadId], references: [id], onDelete: Restrict)
  versionDeTexto VersionDeTexto @relation(fields: [versionDeTextoId], references: [id], onDelete: Restrict)

  @@index([identidadId, tipo, estado])
  @@map("acto_registrable")
}

// ─── WP-03 · Enums de M-02 mínimo, M-03 y el PDP ─────────────────────────────────────────────────

/// T-06-45 — Alcance: Especialidad (Nutrición, Entrenamiento) XOR Capacidad antropométrica transversal (REG-06-32).
enum Alcance {
  NUTRICION
  ENTRENAMIENTO
  ANTROPOMETRIA
}

/// Finalidad sintética, una por alcance (06:251 REFERENCIADO; el catálogo es del 08; DEUDA_LEGAJO DL-039).
enum Finalidad {
  ACOMPANAMIENTO_NUTRICIONAL
  PLANIFICACION_DEL_ENTRENAMIENTO
  EVALUACION_ANTROPOMETRICA
}

/// 08 §12.3 — perfil del profesional, para diferenciar el texto de B2.
enum TipoDePerfilProfesional {
  SANITARIO
  NO_SANITARIO
}

/// T-06-11 — Verificación profesional por Alcance (06 §6.8.1). Lista blanca: @be/domain + trigger.
enum EstadoDeVerificacionProfesional {
  PENDIENTE
  VERIFICADO
  RECHAZADO
  SUSPENDIDO
}

/// T-06-13 — Habilitación mínima: concesión explícita y retiro (REG-06-79; 06 §8.6.6; DL-036).
enum EstadoDeHabilitacion {
  CONCEDIDA
  RETIRADA
}

/// T-06-16 — Solicitud de vínculo (06 §7.3.1). Inicial PENDIENTE; los otros cuatro son terminales.
enum EstadoDeSolicitudDeVinculo {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CADUCADA
  INVALIDADA
}

/// T-06-15 — Vínculo por Alcance (06 §7.5.1). FINALIZADO es terminal (INV-06-58).
enum EstadoDeAlcanceDeVinculo {
  ACEPTADO
  PAUSADO
  FINALIZADO
}

/// T-06-17 — situación del Consentimiento (06 §7.7.4).
enum SituacionDeConsentimiento {
  VIGENTE
  REVOCADO
}

/// REG-06-50 — decisión expresa que emite cada Versión de consentimiento.
enum DecisionDeConsentimiento {
  OTORGAMIENTO
  NUEVA_VERSION
  REVOCACION
  REOTORGAMIENTO
}

/// Rol de cada parte en la solicitud y en el vínculo.
enum RolEnVinculo {
  PROFESIONAL
  ASESORADO
}

/// DL-033 — motivos de pausa y de finalización. Lista cerrada, sin texto libre; CIERRE_DE_CUENTA solo el sistema.
enum MotivoDeTransicionDeVinculo {
  DECISION_PERSONAL
  DISPONIBILIDAD
  OBJETIVO_CUMPLIDO
  CAMBIO_DE_PROFESIONAL
  OTRO
  CIERRE_DE_CUENTA
}

/// Hechos de M-03 (06 §7). El §7 no los nombra: nombres derivados (DL-033).
enum TipoDeEventoDeVinculo {
  SolicitudDeVinculoCreada
  SolicitudDeVinculoAceptada
  SolicitudDeVinculoRechazada
  SolicitudDeVinculoCaducada
  SolicitudDeVinculoInvalidada
  AlcanceDeVinculoAceptado
  AlcanceDeVinculoPausado
  AlcanceDeVinculoReanudado
  AlcanceDeVinculoFinalizado
  ConsentimientoOtorgado
  NuevaVersionDeConsentimientoAceptada
  ConsentimientoRevocado
  ConsentimientoOtorgadoNuevamente
}

/// Hechos de M-02 mínimo (DL-036). Nombres derivados.
enum TipoDeEventoDeVerificacion {
  PerfilProfesionalCreado
  AlcancePresentado
  ObservacionRegistrada
  SubsanacionPresentada
  AlcanceVerificado
  AlcanceRechazado
  AlcancePresentadoNuevamente
  AlcanceSuspendido
  AlcanceRehabilitado
  HabilitacionConcedida
  HabilitacionRetirada
}

/// 08 §29 — resultado de una decisión de acceso del PDP.
enum ResultadoDeDecision {
  PERMITIDA
  DENEGADA
}

/// RF-021 (04:317) y 06 §7.8: las siete dimensiones (DL-032).
enum DimensionDeAutorizacion {
  ROL
  ESPECIALIDAD_O_CAPACIDAD
  SITUACION
  VINCULO
  CONSENTIMIENTO
  FINALIDAD
  ALCANCE
}

// ─── WP-03 · M-02 mínimo: perfil profesional, verificación y habilitación (06 §6; DL-036) ───────

/// «Una Identidad BE posee 0..1 Perfil profesional. Puede estar incompleto y no concede Especialidad, Verificación,
/// Habilitación ni acceso» (06:2766). Lo carga el servicio interno (DL-036); nombre visible sintético (DL-040).
model PerfilProfesional {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId         String                  @unique @map("identidad_id") @db.Uuid
  tipo                TipoDePerfilProfesional
  nombreVisible       String                  @map("nombre_visible")
  procedencia         Json
  momentoDeOcurrencia DateTime?               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@map("perfil_profesional")
}

/// T-06-11 — «Identidad BE + Alcance — Verificación profesional | una situación efectiva» (06:2870).
/// La historia de la trayectoria vive en EventoDeVerificacion.
model VerificacionProfesional {
  id                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId               String                          @map("identidad_id") @db.Uuid
  alcance                   Alcance
  estado                    EstadoDeVerificacionProfesional @default(PENDIENTE)
  /// Concurrencia optimista: avanza de a uno en cada transición (trigger).
  version                   Int                             @default(1)
  procedencia               Json
  momentoDeOcurrencia       DateTime?                       @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro         DateTime                        @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeUltimaTransicion DateTime?                       @map("momento_de_ultima_transicion") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@unique([identidadId, alcance])
  @@map("verificacion_profesional")
}

/// T-06-13 — Habilitación por (Identidad, Alcance), separada de la verificación (06:2782-2788; INV-06-88).
model Habilitacion {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId               String               @map("identidad_id") @db.Uuid
  alcance                   Alcance
  estado                    EstadoDeHabilitacion @default(CONCEDIDA)
  version                   Int                  @default(1)
  procedencia               Json
  momentoDeOcurrencia       DateTime?            @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro         DateTime             @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeUltimaTransicion DateTime?            @map("momento_de_ultima_transicion") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@unique([identidadId, alcance])
  @@map("habilitacion")
}

/// T-06-N08 — hechos de M-02 mínimo. Append-only. El actor es siempre el servicio interno (DL-036).
model EventoDeVerificacion {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Orden total de los hechos (ver EventoDeVinculo).
  secuencia           BigInt                     @unique @default(autoincrement())
  tipo                TipoDeEventoDeVerificacion
  identidadId         String                     @map("identidad_id") @db.Uuid
  alcance             Alcance?
  estadoPrevio        String?                    @map("estado_previo")
  estadoPosterior     String?                    @map("estado_posterior")
  fundamento          String?
  actorServicio       String                     @map("actor_servicio")
  procedencia         Json
  momentoDeOcurrencia DateTime?                  @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                   @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@index([identidadId, alcance])
  @@map("evento_de_verificacion")
}

// ─── WP-03 · M-03: solicitud, vínculo por alcance y consentimiento (06 §7) ─────────────────────

/// T-06-16 — «identificador, profesional, asesorado …, exactamente un Alcance, finalidad, actor iniciador, doble
/// temporalidad, procedencia, estado y antecedente si se reitera» (06:3012). Invitación a personas sin cuenta: fuera
/// de WP-03 (DL-023). REG-06-44: una sola equivalente PENDIENTE, con índice único parcial (en la migración).
model SolicitudDeVinculo {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId       String                     @map("profesional_id") @db.Uuid
  asesoradoId         String                     @map("asesorado_id") @db.Uuid
  alcance             Alcance
  finalidad           Finalidad
  /// «actor iniciador» (06:3012).
  iniciador           RolEnVinculo
  estado              EstadoDeSolicitudDeVinculo @default(PENDIENTE)
  version             Int                        @default(1)
  /// «Reiterar crea nueva Solicitud relacionada» (REG-06-45).
  antecedenteId       String?                    @map("antecedente_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime?                  @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                   @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  /// Caducidad parametrizada (DL-037): el 06 fija la transición, no la duración.
  venceEn             DateTime                   @map("vence_en") @db.Timestamptz(3)
  /// Cuándo salió de PENDIENTE.
  momentoDeResolucion DateTime?                  @map("momento_de_resolucion") @db.Timestamptz(3)

  profesional      Identidad            @relation("SolicitudDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  asesorado        Identidad            @relation("SolicitudAlAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict)
  antecedente      SolicitudDeVinculo?  @relation("Reiteracion", fields: [antecedenteId], references: [id], onDelete: Restrict)
  reiteraciones    SolicitudDeVinculo[] @relation("Reiteracion")
  alcanceDeVinculo AlcanceDeVinculo?
  eventos          EventoDeVinculo[]

  @@index([profesionalId, estado])
  @@index([asesoradoId, estado])
  @@map("solicitud_de_vinculo")
}

/// T-06-15 — «Vínculo agrupa 1..N componentes de Alcance» (06:3091). No tiene estado propio: el estado vive en cada
/// componente (06:3093). Uno por (profesional, asesorado): unicidad derivada (DL-034). Inmutable.
model Vinculo {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId       String    @map("profesional_id") @db.Uuid
  asesoradoId         String    @map("asesorado_id") @db.Uuid
  momentoDeOcurrencia DateTime? @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional Identidad          @relation("VinculoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  asesorado   Identidad          @relation("VinculoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict)
  alcances    AlcanceDeVinculo[]

  @@unique([profesionalId, asesoradoId])
  @@map("vinculo")
}

/// Componente de Vínculo por Alcance = `relationshipId` del 09 (DL-034). «Cada componente conserva Alcance, finalidad,
/// Solicitud de origen, estado, actor/autoría, ocurrencia/registro, procedencia y motivo cuando aplique» (06:3091).
/// Un solo componente no FINALIZADO por (vínculo, alcance): índice parcial (en la migración; INV-06-58).
model AlcanceDeVinculo {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vinculoId                String                       @map("vinculo_id") @db.Uuid
  alcance                  Alcance
  finalidad                Finalidad
  solicitudDeOrigenId      String                       @unique @map("solicitud_de_origen_id") @db.Uuid
  estado                   EstadoDeAlcanceDeVinculo     @default(ACEPTADO)
  version                  Int                          @default(1)
  /// Mientras está PAUSADO: quién pausó (solo esa parte reanuda, DL-033). Se conserva al finalizar desde PAUSADO.
  pausadoPor               RolEnVinculo?                @map("pausado_por")
  motivoDeUltimaTransicion MotivoDeTransicionDeVinculo? @map("motivo_de_ultima_transicion")
  procedencia              Json
  momentoDeOcurrencia      DateTime?                    @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro        DateTime                     @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  vinculo           Vinculo            @relation(fields: [vinculoId], references: [id], onDelete: Restrict)
  solicitudDeOrigen SolicitudDeVinculo @relation(fields: [solicitudDeOrigenId], references: [id], onDelete: Restrict)
  consentimientos   Consentimiento[]
  eventos           EventoDeVinculo[]
  decisiones        DecisionDeAcceso[]

  @@index([vinculoId, alcance])
  @@map("alcance_de_vinculo")
}

/// T-06-17 — B2. «Se identifica longitudinalmente por asesorado + profesional + Alcance de Vínculo + finalidad»
/// (06:3127): uno por (alcance de vínculo, finalidad). La situación cambia solo por transición (06 §7.7.5) y cada
/// decisión emite una VersionDeConsentimiento (REG-06-50). No hay FK a la versión vigente: es la cabeza de la cadena.
model Consentimiento {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alcanceDeVinculoId  String                    @map("alcance_de_vinculo_id") @db.Uuid
  finalidad           Finalidad
  situacion           SituacionDeConsentimiento @default(VIGENTE)
  version             Int                       @default(1)
  momentoDeOcurrencia DateTime?                 @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  alcanceDeVinculo AlcanceDeVinculo          @relation(fields: [alcanceDeVinculoId], references: [id], onDelete: Restrict)
  versiones        VersionDeConsentimiento[]
  eventos          EventoDeVinculo[]
  decisiones       DecisionDeAcceso[]

  @@unique([alcanceDeVinculoId, finalidad])
  @@map("consentimiento")
}

/// REG-06-50 / 08 §12.2 — cada decisión expresa: evidencia inmutable. Cadena lineal: una raíz por consentimiento y como
/// máximo una sucesora por versión (REG-06-12). Revocar emite una versión sin texto («Versión + evento de revocación»).
model VersionDeConsentimiento {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consentimientoId    String                    @map("consentimiento_id") @db.Uuid
  predecesoraId       String?                   @unique @map("predecesora_id") @db.Uuid
  decision            DecisionDeConsentimiento
  situacionResultante SituacionDeConsentimiento @map("situacion_resultante")
  /// Versión del texto mostrado = aceptado (08 §12.2), con su hash copiado. NULL solo en REVOCACION.
  versionDeTextoId    String?                   @map("version_de_texto_id")
  hashDelTexto        String?                   @map("hash_del_texto")
  alcance             Alcance
  finalidad           Finalidad
  /// 08:374 «versión/perfil de matriz de pertinencia y categorías»: sin matriz todavía (DL-039).
  categorias          Json                      @default("[]")
  versionDeMatriz     String?                   @map("version_de_matriz")
  superficie          Superficie?
  direccionIp         String?                   @map("direccion_ip")
  agenteDeUsuario     String?                   @map("agente_de_usuario")
  /// Solo el asesorado titular decide (INV-06-62).
  actorId             String                    @map("actor_id") @db.Uuid
  autoriaId           String                    @map("autoria_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime                  @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  consentimiento Consentimiento           @relation(fields: [consentimientoId], references: [id], onDelete: Restrict)
  predecesora    VersionDeConsentimiento? @relation("CadenaDeConsentimiento", fields: [predecesoraId], references: [id], onDelete: Restrict)
  sucesora       VersionDeConsentimiento? @relation("CadenaDeConsentimiento")
  versionDeTexto VersionDeTexto?          @relation(fields: [versionDeTextoId], references: [id], onDelete: Restrict)
  eventos        EventoDeVinculo[]
  decisiones     DecisionDeAcceso[]

  @@index([consentimientoId])
  @@map("version_de_consentimiento")
}

/// T-06-N08 — hechos de M-03. Append-only, con estado previo y posterior (patrón 06 §5.7.5).
model EventoDeVinculo {
  id                        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Orden total de los hechos: los de una misma transacción comparten momento de registro (hora de la transacción).
  secuencia                 BigInt                       @unique @default(autoincrement())
  tipo                      TipoDeEventoDeVinculo
  profesionalId             String                       @map("profesional_id") @db.Uuid
  asesoradoId               String                       @map("asesorado_id") @db.Uuid
  solicitudDeVinculoId      String?                      @map("solicitud_de_vinculo_id") @db.Uuid
  alcanceDeVinculoId        String?                      @map("alcance_de_vinculo_id") @db.Uuid
  consentimientoId          String?                      @map("consentimiento_id") @db.Uuid
  versionDeConsentimientoId String?                      @map("version_de_consentimiento_id") @db.Uuid
  estadoPrevio              String?                      @map("estado_previo")
  estadoPosterior           String                       @map("estado_posterior")
  motivo                    MotivoDeTransicionDeVinculo?
  /// Actor: una identidad o el sistema. Exactamente uno (CHECK en la migración).
  actorId                   String?                      @map("actor_id") @db.Uuid
  actorServicio             String?                      @map("actor_servicio")
  procedencia               Json
  momentoDeOcurrencia       DateTime?                    @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro         DateTime                     @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  // Sin CASCADE: la historia es por adición (08 §17).
  profesional             Identidad                @relation("EventoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado               Identidad                @relation("EventoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  solicitudDeVinculo      SolicitudDeVinculo?      @relation(fields: [solicitudDeVinculoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alcanceDeVinculo        AlcanceDeVinculo?        @relation(fields: [alcanceDeVinculoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consentimiento          Consentimiento?          @relation(fields: [consentimientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDeConsentimiento VersionDeConsentimiento? @relation(fields: [versionDeConsentimientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([asesoradoId, momentoDeRegistro])
  @@index([solicitudDeVinculoId])
  @@index([alcanceDeVinculoId])
  @@index([consentimientoId])
  @@map("evento_de_vinculo")
}

// ─── WP-03 · PDP: decisiones de acceso (08 §29; REG-06-50) ──────────────────────────────────────

/// Cada decisión del PDP sobre una operación protegida, permitida o denegada, en la misma transacción (08 §29, 08:650).
/// Registra la versión de consentimiento que la resolvió y la de la matriz, hoy nula (08:307; DL-039). La dimensión
/// desfavorable queda acá y nunca en la respuesta (UC-I02 E05). Append-only.
model DecisionDeAcceso {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Orden total de las decisiones: permite ubicar la «primera denegación posterior» a una revocación (08:404).
  secuencia                 BigInt                    @unique @default(autoincrement())
  operacion                 String
  resultado                 ResultadoDeDecision
  actorId                   String                    @map("actor_id") @db.Uuid
  /// Titular intentado; NULL si no existe o el identificador no es válido (08 §29 «sujeto intentado»).
  sujetoId                  String?                   @map("sujeto_id") @db.Uuid
  alcance                   Alcance
  finalidad                 Finalidad
  dimensionesDesfavorables  DimensionDeAutorizacion[] @map("dimensiones_desfavorables")
  alcanceDeVinculoId        String?                   @map("alcance_de_vinculo_id") @db.Uuid
  consentimientoId          String?                   @map("consentimiento_id") @db.Uuid
  versionDeConsentimientoId String?                   @map("version_de_consentimiento_id") @db.Uuid
  versionDeMatriz           String?                   @map("version_de_matriz")
  /// WP-04: recurso concreto al que se accede (08:634, «recurso/categoría»). NULL en API-DSH-03, que es por titular.
  recursoTipo               String?                   @map("recurso_tipo")
  recursoId                 String?                   @map("recurso_id") @db.Uuid
  superficie                Superficie?
  requestId                 String?                   @map("request_id")
  momentoDeOcurrencia       DateTime                  @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro         DateTime                  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  actor                   Identidad                @relation("DecisionDelActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sujeto                  Identidad?               @relation("DecisionSobreElSujeto", fields: [sujetoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  alcanceDeVinculo        AlcanceDeVinculo?        @relation(fields: [alcanceDeVinculoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consentimiento          Consentimiento?          @relation(fields: [consentimientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDeConsentimiento VersionDeConsentimiento? @relation(fields: [versionDeConsentimientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, sujetoId, alcance, momentoDeRegistro])
  @@map("decision_de_acceso")
}

// ─── Historia: eventos, cierre, supresión, auditoría, idempotencia ─────────────────────────────

/// T-06-N08 — Evento de dominio: hecho ocurrido y registrado, inmutable, con ocurrencia, registro, autoría y procedencia.
model EventoDeDominio {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                TipoDeEventoDeDominio
  /// Identidad sujeto del hecho.
  identidadId         String                   @map("identidad_id") @db.Uuid
  /// Actor que ejecutó (identidad) o servicio interno (DL-020). Exactamente uno (CHECK en la migración).
  actorId             String?                  @map("actor_id") @db.Uuid
  actorServicio       String?                  @map("actor_servicio")
  autoriaId           String?                  @map("autoria_id") @db.Uuid
  procedencia         Json
  /// 06 §5.7.5: estado anterior y resultante en las transiciones de cuenta.
  estadoAnterior      EstadoOperativoDeCuenta? @map("estado_anterior")
  estadoResultante    EstadoOperativoDeCuenta? @map("estado_resultante")
  datos               Json?
  momentoDeOcurrencia DateTime?                @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                 @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict)

  @@index([identidadId, tipo])
  @@map("evento_de_dominio")
}

/// RF-069 «La solicitud identifica actor y fecha» (04:158). Una por identidad: CERRADA es terminal.
model SolicitudDeCierreDeCuenta {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId              String   @unique @map("identidad_id") @db.Uuid
  actorId                  String   @map("actor_id") @db.Uuid
  /// «consecuencias presentadas» (06 §5.7.4): versión del texto mostrado.
  versionDeConsecuenciasId String   @map("version_de_consecuencias_id")
  procedencia              Json
  momentoDeOcurrencia      DateTime @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro        DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad              Identidad      @relation(fields: [identidadId], references: [id], onDelete: Restrict)
  versionDeConsecuencias VersionDeTexto @relation(fields: [versionDeConsecuenciasId], references: [id], onDelete: Restrict)

  @@map("solicitud_de_cierre_de_cuenta")
}

/// 08 §18 «registro de supresiones (deletion ledger)»: categoría, sujeto, fundamento y ejecutor. Append-only.
model RegistroDeSupresion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria           String
  sujetoId            String   @map("sujeto_id") @db.Uuid
  fundamento          String
  ejecutor            String
  momentoDeOcurrencia DateTime @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@index([sujetoId])
  @@map("registro_de_supresion")
}

/// 08 §29 — auditoría probatoria en la base, separada de los logs, append-only. Sin IP, user-agent ni identificadores en claro.
model RegistroDeAuditoria {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Operación del 09 (p. ej. API-ACC-02).
  operacion           String
  resultado           ResultadoDeOperacion
  /// Código interno del resultado (p. ej. INVALID_CREDENTIALS, IDENTIDAD_INEXISTENTE). Nunca se expone.
  motivo              String?
  actorId             String?              @map("actor_id") @db.Uuid
  /// Identidad afectada, si existe.
  sujetoId            String?              @map("sujeto_id") @db.Uuid
  recursoTipo         String?              @map("recurso_tipo")
  recursoId           String?              @map("recurso_id")
  superficie          Superficie?
  requestId           String?              @map("request_id")
  momentoDeOcurrencia DateTime?            @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime             @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@index([sujetoId])
  @@index([operacion, momentoDeRegistro])
  @@map("registro_de_auditoria")
}

/// Idempotency-Key (09v7 T07). La huella excluye la credencial (DEUDA_LEGAJO DL-026). Append-only.
model RegistroDeIdempotencia {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operacion         String
  /// Actor autenticado o «PUBLICO» (namespace, DL-026).
  ambito            String
  clave             String
  huella            String
  estadoHttp        Int      @map("estado_http")
  cuerpo            Json
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@unique([operacion, ambito, clave])
  @@map("registro_de_idempotencia")
}

// ─── WP-04 · Proceso operativo (06 §8, B-04) y capacidad (06 §9, B-05) ────────────────────────────

enum ModoDeCapacidad {
  LIMITADA
  SIN_LIMITE
}

/// 06:3413-3418: dos estados. NUEVO y VIGENTE son predicados (INV-06-71, 72).
enum EstadoDeProceso {
  ABIERTO
  CERRADO
}

enum MotivoDeCierreDeProceso {
  REVISION_FINALIZAR
  FINALIZACION_DE_VINCULO
  CIERRE_DE_CUENTA
}

/// 06:3563-3570.
enum TipoDeEventoDeProceso {
  ProcesoOperativoAbierto
  ContinuidadOCierreAplicado
  ProcesoOperativoCerrado
}

/// REG-06-75: tipo del evento ContinuidadOCierreAplicado.
enum TipoDeAplicacion {
  CONTINUIDAD
  CIERRE_PROCESO
}

enum FuenteDeProximaRevision {
  VERSION_DE_PLAN
  REVISION
}

/// B-05 (REG-06-81, 83): capacidad por identidad profesional, versionada por adición. Sin versión → SIN_LIMITE
/// (REG-06-82). La vigente es la terminal de la cadena. Quién la configura: DEUDA_LEGAJO DL-051.
model CapacidadProfesional {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadId         String          @map("identidad_id") @db.Uuid
  predecesoraId       String?         @unique @map("predecesora_id") @db.Uuid
  modo                ModoDeCapacidad
  limite              Int?
  actorServicio       String          @map("actor_servicio")
  procedencia         Json
  momentoDeOcurrencia DateTime?       @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime        @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  identidad   Identidad             @relation(fields: [identidadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora CapacidadProfesional? @relation("CadenaDeCapacidad", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora    CapacidadProfesional? @relation("CadenaDeCapacidad")

  @@index([identidadId])
  @@map("capacidad_profesional")
}

/// T-06-25 — Proceso operativo. Como máximo uno ABIERTO por (profesional, asesorado, alcance): índice parcial en la
/// migración (INV-06-74). CERRADO es terminal (INV-06-86).
model ProcesoOperativo {
  id                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId                    String                   @map("profesional_id") @db.Uuid
  asesoradoId                      String                   @map("asesorado_id") @db.Uuid
  alcance                          Alcance
  estado                           EstadoDeProceso          @default(ABIERTO)
  version                          Int                      @default(1)
  motivoDeCierre                   MotivoDeCierreDeProceso? @map("motivo_de_cierre")
  /// «acto de apertura y versión/plan de apertura» (06:3364). Una de las dos, según el alcance del Proceso.
  versionDeAperturaId              String?                  @unique @map("version_de_apertura_id") @db.Uuid
  versionDeAperturaEntrenamientoId String?                  @unique @map("version_de_apertura_entrenamiento_id") @db.Uuid
  procedencia                      Json
  momentoDeOcurrencia              DateTime?                @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro                DateTime                 @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeCierre                  DateTime?                @map("momento_de_cierre") @db.Timestamptz(3)

  profesional                    Identidad                     @relation("ProcesoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado                      Identidad                     @relation("ProcesoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDeApertura              VersionDePlanNutricional?     @relation("AperturaDeProceso", fields: [versionDeAperturaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDeAperturaEntrenamiento VersionDePlanDeEntrenamiento? @relation("AperturaDeProcesoDeEntrenamiento", fields: [versionDeAperturaEntrenamientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventos                        EventoDeProceso[]
  revisiones                     RevisionNutricional[]
  revisionesDeEntrenamiento      RevisionDeEntrenamiento[]     @relation("RevisionDeEntrenamientoDelProceso")
  proximasRevisiones             ProximaRevision[]

  @@index([profesionalId, asesoradoId, alcance])
  @@map("proceso_operativo")
}

/// Hechos de M-04 (06:3563-3570). Append-only. ContinuidadOCierreAplicado se emite solo con la consecuencia aplicada
/// (REG-06-75, 77).
model EventoDeProceso {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secuencia                 BigInt                @unique @default(autoincrement())
  tipo                      TipoDeEventoDeProceso
  procesoId                 String                @map("proceso_id") @db.Uuid
  tipoDeAplicacion          TipoDeAplicacion?     @map("tipo_de_aplicacion")
  revisionId                String?               @map("revision_id") @db.Uuid
  revisionDeEntrenamientoId String?               @map("revision_de_entrenamiento_id") @db.Uuid
  estadoPrevio              EstadoDeProceso?      @map("estado_previo")
  estadoPosterior           EstadoDeProceso       @map("estado_posterior")
  /// Referencias de versiones cuando correspondan (REG-06-75).
  datos                     Json?
  actorId                   String?               @map("actor_id") @db.Uuid
  actorServicio             String?               @map("actor_servicio")
  procedencia               Json
  momentoDeOcurrencia       DateTime?             @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro         DateTime              @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  proceso                   ProcesoOperativo                     @relation(fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision                  RevisionNutricional?                 @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeEntrenamiento   RevisionDeEntrenamiento?             @relation("EventoDeRevisionDeEntrenamiento", fields: [revisionDeEntrenamientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aplicacion                AplicacionDeRevision?
  aplicacionDeEntrenamiento AplicacionDeRevisionDeEntrenamiento? @relation("AplicacionDeEntrenamientoDelEvento")

  @@index([procesoId])
  @@map("evento_de_proceso")
}

/// REG-06-145/146: expectativa de revisión. Reprogramar crea una nueva y la anterior queda histórica (cadena lineal).
model ProximaRevision {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procesoId                      String                  @map("proceso_id") @db.Uuid
  predecesoraId                  String?                 @unique @map("predecesora_id") @db.Uuid
  /// NULL = sin fecha: pendiente desde que se registró (REG-06-150).
  fechaObjetivo                  DateTime?               @map("fecha_objetivo") @db.Date
  fuente                         FuenteDeProximaRevision
  versionDePlanId                String?                 @map("version_de_plan_id") @db.Uuid
  versionDePlanDeEntrenamientoId String?                 @map("version_de_plan_de_entrenamiento_id") @db.Uuid
  revisionId                     String?                 @map("revision_id") @db.Uuid
  revisionDeEntrenamientoId      String?                 @map("revision_de_entrenamiento_id") @db.Uuid
  actorId                        String                  @map("actor_id") @db.Uuid
  procedencia                    Json
  momentoDeOcurrencia            DateTime?               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro              DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  proceso                      ProcesoOperativo              @relation(fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora                  ProximaRevision?              @relation("CadenaDeProximaRevision", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora                     ProximaRevision?              @relation("CadenaDeProximaRevision")
  versionDePlan                VersionDePlanNutricional?     @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision                     RevisionNutricional?          @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDePlanDeEntrenamiento VersionDePlanDeEntrenamiento? @relation("ProximaRevisionDePlanDeEntrenamiento", fields: [versionDePlanDeEntrenamientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeEntrenamiento      RevisionDeEntrenamiento?      @relation("ProximaRevisionDeRevisionDeEntrenamiento", fields: [revisionDeEntrenamientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([procesoId])
  @@map("proxima_revision")
}

// ─── WP-04 · Circuito nutricional (06 §10, B-07) ──────────────────────────────────────────────────

/// Condición de disponibilidad para nuevas planificaciones (REG-06-99; 06:4235). Estado, nunca booleano (WP-02).
enum DisponibilidadDeElemento {
  DISPONIBLE
  RETIRADO
}

enum ProcedenciaDeCatalogo {
  BE_SYNTHETIC_SEED
  PROFESSIONAL_MANUAL
}

/// 06 §10.7: BORRADOR y ACTIVADA. No hay salida desde ACTIVADA (06:4307; trigger en la migración).
enum EstadoDeVersionDePlan {
  BORRADOR
  ACTIVADA
}

enum OrigenDeIngesta {
  PRESCRIPTA
  FUERA_DE_PRESCRIPCION
}

enum ModoDeRegistroDeIngesta {
  OPCIONES_DE_PLATO
  DESCRIPCION_LIBRE
}

/// REG-06-144.
enum ResultadoDeRevision {
  MANTENER
  AJUSTAR
  SUSTITUIR
  REPROGRAMAR_REVISION
  CAMBIAR_OBJETIVO
  FINALIZAR
}

/// Hechos del circuito nutricional. El §10 no publica nombres de eventos: son derivados (como DL-033).
enum TipoDeEventoDeNutricion {
  ElementoDeCatalogoCreado
  EvaluacionNutricionalRegistrada
  VersionDeObjetivoEmitida
  BorradorDePlanCreado
  BorradorDePlanGuardado
  VersionDePlanActivada
  IngestaRegistrada
  CorreccionDeIngestaRegistrada
  RevisionRegistrada
}

/// T-06-31 — Elemento de catálogo: identificador BE estable (REG-06-99). Inmutable; el contenido vive en sus versiones.
model ElementoDeCatalogoNutricional {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procedencia       ProcedenciaDeCatalogo
  /// Profesional que lo cargó (PROFESSIONAL_MANUAL); NULL en el catálogo sembrado.
  creadoPorId       String?               @map("creado_por_id") @db.Uuid
  momentoDeRegistro DateTime              @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  versiones VersionDeElementoNutricional[]

  @@map("elemento_de_catalogo_nutricional")
}

/// Versión de un elemento de catálogo. Append-only: retirar un elemento emite una versión no disponible, y ninguna
/// versión reescribe una instantánea (REG-06-101; INV-06-115). La vigente es la terminal de la cadena.
model VersionDeElementoNutricional {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  elementoId        String                   @map("elemento_id") @db.Uuid
  predecesoraId     String?                  @unique @map("predecesora_id") @db.Uuid
  nombre            String
  composicion       Json
  disponibilidad    DisponibilidadDeElemento
  procedencia       Json
  momentoDeRegistro DateTime                 @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  elemento    ElementoDeCatalogoNutricional @relation(fields: [elementoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora VersionDeElementoNutricional? @relation("CadenaDeElemento", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora    VersionDeElementoNutricional? @relation("CadenaDeElemento")

  @@index([elementoId])
  @@map("version_de_elemento_nutricional")
}

/// REG-06-97 — Evaluación nutricional: hecho identificable; una posterior no sobrescribe la anterior. Append-only.
model EvaluacionNutricional {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId       String   @map("profesional_id") @db.Uuid
  asesoradoId         String   @map("asesorado_id") @db.Uuid
  contexto            String?
  /// Datos con su fuente: informado, observado o calculado (REG-06-109; DL-048).
  valoracion          Json
  referencias         Json
  notas               String?
  procedencia         Json
  momentoDeOcurrencia DateTime @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional Identidad                      @relation("EvaluacionDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado   Identidad                      @relation("EvaluacionDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  objetivos   VersionDeObjetivoNutricional[]

  @@index([asesoradoId, profesionalId, momentoDeRegistro])
  @@map("evaluacion_nutricional")
}

/// T-06-27 — Objetivo: uno por (profesional, asesorado); sus versiones forman una sucesión lineal y la efectiva es la
/// terminal (REG-06-98; INV-06-107). Inmutable.
model ObjetivoNutricional {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId     String   @map("profesional_id") @db.Uuid
  asesoradoId       String   @map("asesorado_id") @db.Uuid
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional Identidad                      @relation("ObjetivoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado   Identidad                      @relation("ObjetivoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versiones   VersionDeObjetivoNutricional[]

  @@unique([profesionalId, asesoradoId])
  @@map("objetivo_nutricional")
}

/// Versión de objetivo: decisión profesional con fundamento obligatorio; BE no la calcula (REG-06-123; INV-06-133).
/// Append-only.
model VersionDeObjetivoNutricional {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objetivoId                    String    @map("objetivo_id") @db.Uuid
  predecesoraId                 String?   @unique @map("predecesora_id") @db.Uuid
  evaluacionId                  String    @map("evaluacion_id") @db.Uuid
  vigenteDesde                  DateTime  @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta                  DateTime? @map("vigente_hasta") @db.Timestamptz(3)
  requerimientoEnergetico       Json      @map("requerimiento_energetico")
  distribucionDeMacronutrientes Json      @map("distribucion_de_macronutrientes")
  distribucionPorComida         String?   @map("distribucion_por_comida")
  fundamento                    String
  declaracionDeMetodo           String?   @map("declaracion_de_metodo")
  /// Revisión CAMBIAR_OBJETIVO que la emitió, si la hay (REG-06-147).
  revisionDeOrigenId            String?   @map("revision_de_origen_id") @db.Uuid
  autorId                       String    @map("autor_id") @db.Uuid
  procedencia                   Json
  momentoDeRegistro             DateTime  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  objetivo         ObjetivoNutricional           @relation(fields: [objetivoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora      VersionDeObjetivoNutricional? @relation("CadenaDeObjetivo", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora         VersionDeObjetivoNutricional? @relation("CadenaDeObjetivo")
  evaluacion       EvaluacionNutricional         @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeOrigen RevisionNutricional?          @relation("ObjetivoDeRevision", fields: [revisionDeOrigenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionesDePlan  VersionDePlanNutricional[]

  @@index([objetivoId])
  @@map("version_de_objetivo_nutricional")
}

/// T-06-28 — Plan: uno por (profesional, asesorado). `versionEfectivaId` es la relación explícita a la versión efectiva
/// (INV-06-110): solo avanza a la sucesora activada de la anterior (trigger).
model PlanNutricional {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId     String   @map("profesional_id") @db.Uuid
  asesoradoId       String   @map("asesorado_id") @db.Uuid
  versionEfectivaId String?  @unique @map("version_efectiva_id") @db.Uuid
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional     Identidad                  @relation("PlanDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado       Identidad                  @relation("PlanDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionEfectiva VersionDePlanNutricional?  @relation("VersionEfectiva", fields: [versionEfectivaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versiones       VersionDePlanNutricional[] @relation("VersionesDelPlan")

  @@unique([profesionalId, asesoradoId])
  @@map("plan_nutricional")
}

/// T-06-29 — Versión de plan (06 §10.7). El contenido es la jerarquía validada por @be/domain (WP-04 T3). Un solo
/// BORRADOR por plan y una sola sucesora por versión (REG-06-12). ACTIVADA es inmutable (INV-06-109; trigger).
model VersionDePlanNutricional {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String                @map("plan_id") @db.Uuid
  predecesoraId       String?               @unique @map("predecesora_id") @db.Uuid
  estado              EstadoDeVersionDePlan @default(BORRADOR)
  version             Int                   @default(1)
  versionDeObjetivoId String                @map("version_de_objetivo_id") @db.Uuid
  contenido           Json
  /// Próxima revisión que fija la versión (REG-06-145); al activar, nace la expectativa del Proceso.
  proximaRevision     DateTime?             @map("proxima_revision") @db.Date
  /// Revisión AJUSTAR o SUSTITUIR que la creó, si la hay (DL-052).
  revisionDeOrigenId  String?               @map("revision_de_origen_id") @db.Uuid
  autorId             String                @map("autor_id") @db.Uuid
  procedencia         Json
  momentoDeRegistro   DateTime              @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeActivacion DateTime?             @map("momento_de_activacion") @db.Timestamptz(3)

  plan               PlanNutricional               @relation("VersionesDelPlan", fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora        VersionDePlanNutricional?     @relation("CadenaDePlan", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora           VersionDePlanNutricional?     @relation("CadenaDePlan")
  versionDeObjetivo  VersionDeObjetivoNutricional  @relation(fields: [versionDeObjetivoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeOrigen   RevisionNutricional?          @relation("PlanDeRevision", fields: [revisionDeOrigenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instantanea        InstantaneaDePlanNutricional?
  efectivaDe         PlanNutricional?              @relation("VersionEfectiva")
  procesoAbierto     ProcesoOperativo?             @relation("AperturaDeProceso")
  ingestas           IngestaNutricional[]
  proximasRevisiones ProximaRevision[]

  @@index([planId])
  @@map("version_de_plan_nutricional")
}

/// T-06-21 — Instantánea reproducible: lo emitido con el catálogo resuelto al activar, y su huella SHA-256 (REG-06-13,
/// 105). Una por versión activada. Append-only.
model InstantaneaDePlanNutricional {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionDePlanId   String   @unique @map("version_de_plan_id") @db.Uuid
  contenido         Json
  huella            String
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  versionDePlan VersionDePlanNutricional @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("instantanea_de_plan_nutricional")
}

/// T-06-54 — Ingesta registrada: hecho confirmado contra una versión ACTIVADA; nunca modifica la prescripción
/// (REG-06-106). La prescripta es única por (versión, fecha, comida) (DL-049). Append-only.
model IngestaNutricional {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionDePlanId      String                  @map("version_de_plan_id") @db.Uuid
  asesoradoId          String                  @map("asesorado_id") @db.Uuid
  origen               OrigenDeIngesta
  modo                 ModoDeRegistroDeIngesta
  fechaLocal           DateTime                @map("fecha_local") @db.Date
  zonaHoraria          String                  @map("zona_horaria")
  diaTipoId            String?                 @map("dia_tipo_id")
  comidaId             String?                 @map("comida_id")
  opcionId             String?                 @map("opcion_id")
  itemsConsumidos      Json                    @default("[]") @map("items_consumidos")
  observacion          String?
  /// Modalidad C: el texto original se conserva siempre (INV-06-131).
  descripcion          String?
  descripcionDePorcion String?                 @map("descripcion_de_porcion")
  procedencia          Json
  momentoDeOcurrencia  DateTime                @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro    DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  versionDePlan VersionDePlanNutricional @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado     Identidad                @relation("IngestaDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correcciones  CorreccionDeIngesta[]

  @@index([asesoradoId, fechaLocal])
  @@index([versionDePlanId])
  @@map("ingesta_nutricional")
}

/// T-06-22 — Corrección trazable de una ingesta libre (API-NUT-21): estimación profesional, nunca medición. Cadena
/// lineal hacia el original raíz (REG-06-15): una raíz por ingesta y una sucesora por corrección. Append-only.
model CorreccionDeIngesta {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingestaId          String   @map("ingesta_id") @db.Uuid
  correccionPreviaId String?  @unique @map("correccion_previa_id") @db.Uuid
  estimacion         Json
  declaracion        String
  autorId            String   @map("autor_id") @db.Uuid
  procedencia        Json
  momentoDeRegistro  DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  ingesta          IngestaNutricional   @relation(fields: [ingestaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correccionPrevia CorreccionDeIngesta? @relation("CadenaDeCorreccion", fields: [correccionPreviaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siguiente        CorreccionDeIngesta? @relation("CadenaDeCorreccion")

  @@index([ingestaId])
  @@map("correccion_de_ingesta")
}

/// REG-06-141 — Revisión profesional válida: acto explícito, sin máquina de estados, con todos sus componentes.
/// Append-only. Su aplicación (UC-I06) es otro hecho (`AplicacionDeRevision`).
model RevisionNutricional {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procesoId           String              @map("proceso_id") @db.Uuid
  periodoInicio       DateTime            @map("periodo_inicio") @db.Date
  periodoFin          DateTime            @map("periodo_fin") @db.Date
  zonaHoraria         String              @map("zona_horaria")
  evidencias          Json
  interpretacion      String
  resultado           ResultadoDeRevision
  fundamento          String
  proximaAccion       Json                @map("proxima_accion")
  autorId             String              @map("autor_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime?           @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime            @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  proceso            ProcesoOperativo               @relation(fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aplicacion         AplicacionDeRevision?
  eventos            EventoDeProceso[]
  planesCreados      VersionDePlanNutricional[]     @relation("PlanDeRevision")
  objetivosCreados   VersionDeObjetivoNutricional[] @relation("ObjetivoDeRevision")
  proximasRevisiones ProximaRevision[]

  @@index([procesoId])
  @@map("revision_nutricional")
}

/// UC-I06 aplicado: una aplicación por revisión, enlazada al evento ContinuidadOCierreAplicado (REG-06-75). Append-only.
model AplicacionDeRevision {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId                String           @unique @map("revision_id") @db.Uuid
  eventoId                  String           @unique @map("evento_id") @db.Uuid
  tipo                      TipoDeAplicacion
  estadoDeProcesoPosterior  EstadoDeProceso  @map("estado_de_proceso_posterior")
  versionDePlanCreadaId     String?          @map("version_de_plan_creada_id") @db.Uuid
  versionDeObjetivoCreadaId String?          @map("version_de_objetivo_creada_id") @db.Uuid
  momentoDeRegistro         DateTime         @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  revision RevisionNutricional @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evento   EventoDeProceso     @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("aplicacion_de_revision")
}

/// Hechos del circuito nutricional, para reconstruir la historia y alimentar el futuro timeline (DL-054). Append-only.
model EventoDeNutricion {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secuencia           BigInt                  @unique @default(autoincrement())
  tipo                TipoDeEventoDeNutricion
  profesionalId       String?                 @map("profesional_id") @db.Uuid
  asesoradoId         String?                 @map("asesorado_id") @db.Uuid
  recursoTipo         String                  @map("recurso_tipo")
  recursoId           String                  @map("recurso_id") @db.Uuid
  estadoPrevio        String?                 @map("estado_previo")
  estadoPosterior     String?                 @map("estado_posterior")
  actorId             String                  @map("actor_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime?               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@index([asesoradoId, momentoDeRegistro])
  @@index([recursoId])
  @@map("evento_de_nutricion")
}

// ─── B-10 · Antropometría (06 §13 y §20) ────────────────────────────────────────────────────────
// Antropometría es Capacidad transversal, nunca tercera Especialidad (06:2774), y una operación aislada no abre
// Proceso ni ocupa capacidad (06 §8.9, §9.11.2; WP-05 §0 D-D).

/// REG-06-214 — la Evaluación distingue preparación y registro. REGISTRADA es terminal.
enum EstadoDeEvaluacionAntropometrica {
  EN_PREPARACION
  REGISTRADA
}

/// REG-06-153 — origen del dato; INV-06-167 no admite exigir formato ni proveedor.
enum OrigenDeMedicion {
  CAPTURA_DIRECTA
  AUTORREPORTE
  IMPORTACION_CONTROLADA
}

/// La frontera que no se puede borrar: medido, informado por la persona y calculado por BE (04:1090).
enum ClaseDeDato {
  MEDIDO
  REPORTADO
  CALCULADO
}

/// REG-06-158 — el redondeo es declarado, no implícito.
enum ModoDeRedondeo {
  MEDIO_ARRIBA
  ABAJO
  ARRIBA
}

/// REG-06-205 — para qué se ejecutó un método. Una versión es seleccionable para las finalidades que declara.
enum FinalidadDeCalculo {
  SOPORTE_ANTROPOMETRICO
  SOPORTE_DE_OBJETIVO_NUTRICIONAL
}

enum TipoDeEventoDeAntropometria {
  EvaluacionAntropometricaRegistrada
  MedicionCorregida
  MedicionAnulada
  CalculoEjecutado
  ReferenciaDeCalculoAdoptada
}

/// REG-06-157 — la fórmula/protocolo es una especificación versionada: el bloque «define la estructura para
/// representarlas y reconstruirlas, no selecciona una como universal» (06:6304). El contenido es sintético y
/// rotulado, como el catálogo de alimentos de WP-04 (WP-05 §7 T15).
model EspecificacionAntropometrica {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Clave estable y legible del protocolo o método (p. ej. PROTO-LAB, MET-DEMO).
  clave             String   @unique
  tipo              String
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  versiones VersionDeEspecificacionAntropometrica[]

  @@map("especificacion_antropometrica")
}

/// Sucesión lineal por relación, como toda versión de B-06. Publicar una versión nueva no modifica evaluaciones
/// anteriores (09v11:336) ni reescribe cálculos históricos (INV-06-172).
model VersionDeEspecificacionAntropometrica {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  especificacionId  String   @map("especificacion_id") @db.Uuid
  predecesoraId     String?  @unique @map("predecesora_id") @db.Uuid
  version           String
  nombre            String
  /// Métricas, unidades admitidas, entradas requeridas y precisión declarada (REG-06-154, 158, 159).
  contenido         Json
  /// Rótulo obligatorio: estos valores son de demostración, no un catálogo científico (REG-06-157).
  procedencia       Json
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  especificacion EspecificacionAntropometrica           @relation(fields: [especificacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora    VersionDeEspecificacionAntropometrica? @relation("SucesionDeEspecificacion", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora       VersionDeEspecificacionAntropometrica? @relation("SucesionDeEspecificacion")
  mediciones     MedicionAntropometrica[]
  ejecuciones    EjecucionDeCalculo[]

  @@index([especificacionId])
  @@map("version_de_especificacion_antropometrica")
}

/// REG-06-151 — Evaluación reconstruible. No se convierte en Plan ni en Revisión de especialidad, y antropometría
/// no adquiere ciclo de plan propio (06:6221).
model EvaluacionAntropometrica {
  id                            String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId                 String                           @map("profesional_id") @db.Uuid
  asesoradoId                   String                           @map("asesorado_id") @db.Uuid
  estado                        EstadoDeEvaluacionAntropometrica @default(EN_PREPARACION)
  contexto                      String?
  /// Token de concurrencia del borrador: REG-06-216 exige detectar que el contenido cambió desde la última lectura.
  version                       Int                              @default(1)
  procedencia                   Json
  momentoDeOcurrencia           DateTime                         @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro             DateTime                         @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  /// Cuándo se ejecutó el acto explícito de registro (REG-06-214 inciso 4). Nulo mientras está en preparación.
  momentoDeRegistroDeEvaluacion DateTime?                        @map("momento_de_registro_de_evaluacion") @db.Timestamptz(3)

  profesional Identidad                @relation("EvaluacionAntropometricaDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado   Identidad                @relation("EvaluacionAntropometricaDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediciones  MedicionAntropometrica[]
  ejecuciones EjecucionDeCalculo[]

  @@index([asesoradoId, profesionalId, estado])
  @@index([profesionalId, estado])
  @@map("evaluacion_antropometrica")
}

/// REG-06-152 — Medición directa, separada del cálculo. REG-06-154: la unidad de origen siempre queda visible.
/// Su condición efectiva (VIGENTE/ANULADA) no se guarda como columna: se deriva de la existencia del evento de
/// anulación, «Una Medición sin evento de anulación está VIGENTE» (06:8670).
model MedicionAntropometrica {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluacionId            String           @map("evaluacion_id") @db.Uuid
  metrica                 String
  valor                   Decimal          @db.Decimal(12, 4)
  /// Unidad tal como se tomó: nunca se normaliza en silencio (REG-06-09).
  unidadDeOrigen          String           @map("unidad_de_origen")
  protocoloVersionId      String           @map("protocolo_version_id") @db.Uuid
  origen                  OrigenDeMedicion
  clase                   ClaseDeDato
  /// CONTROLLED_IMPORT: referencia opaca de la preparación externa, sin entidad propia (DL-062).
  referenciaDePreparacion String?          @map("referencia_de_preparacion")
  procedencia             Json
  momentoDeOcurrencia     DateTime         @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro       DateTime         @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  evaluacion       EvaluacionAntropometrica              @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  protocoloVersion VersionDeEspecificacionAntropometrica @relation(fields: [protocoloVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correcciones     CorreccionDeMedicion[]
  anulacion        AnulacionDeMedicion?
  entradas         EntradaDeCalculo[]

  @@index([evaluacionId])
  @@index([metrica])
  @@map("medicion_antropometrica")
}

/// REG-06-160 — corrección trazable con B-06: cadena lineal sobre el original raíz, que no se toca.
model CorreccionDeMedicion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicionId         String   @map("medicion_id") @db.Uuid
  correccionPreviaId String?  @unique @map("correccion_previa_id") @db.Uuid
  autorId            String   @map("autor_id") @db.Uuid
  motivo             String
  valor              Decimal  @db.Decimal(12, 4)
  unidadDeOrigen     String   @map("unidad_de_origen")
  procedencia        Json
  momentoDeRegistro  DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  medicion         MedicionAntropometrica @relation(fields: [medicionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correccionPrevia CorreccionDeMedicion?  @relation("SucesionDeCorreccionDeMedicion", fields: [correccionPreviaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siguiente        CorreccionDeMedicion?  @relation("SucesionDeCorreccionDeMedicion")
  autor            Identidad              @relation("CorreccionDeMedicionDelAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([medicionId])
  @@map("correccion_de_medicion")
}

/// REG-06-218 — anulación como evento aditivo y TERMINAL. El índice único por medición es lo que hace que una
/// segunda anulación no produzca un segundo efecto (adversarial 6; DL-059).
model AnulacionDeMedicion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicionId          String   @unique @map("medicion_id") @db.Uuid
  autorId             String   @map("autor_id") @db.Uuid
  motivo              String
  procedencia         Json
  momentoDeOcurrencia DateTime @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  medicion MedicionAntropometrica @relation(fields: [medicionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  autor    Identidad              @relation("AnulacionDeMedicionDelAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("anulacion_de_medicion")
}

/// REG-06-156 — resultado derivado reproducible: método, versión, entradas efectivas, precisión y momento.
/// REG-06-205: varias corridas coexisten, sin promedio ni ganador automático. REG-06-161: el recálculo se relaciona
/// con el anterior y no lo sobrescribe.
model EjecucionDeCalculo {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluacionId      String             @map("evaluacion_id") @db.Uuid
  metodoVersionId   String             @map("metodo_version_id") @db.Uuid
  autorId           String             @map("autor_id") @db.Uuid
  metrica           String
  valor             Decimal            @db.Decimal(12, 4)
  unidad            String
  decimales         Int
  modoDeRedondeo    ModoDeRedondeo     @map("modo_de_redondeo")
  /// REG-06-205 — la finalidad es parte de la identidad de la corrida, no una etiqueta posterior.
  finalidad         FinalidadDeCalculo
  /// REG-06-156 — la regla de dominio aplicable, identificada y versionada: sin esto no se reconstruye.
  regla             String
  reemplazaAId      String?            @unique @map("reemplaza_a_id") @db.Uuid
  procedencia       Json
  momentoDeRegistro DateTime           @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  evaluacion     EvaluacionAntropometrica              @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metodoVersion  VersionDeEspecificacionAntropometrica @relation(fields: [metodoVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  autor          Identidad                             @relation("EjecucionDeCalculoDelAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reemplazaA     EjecucionDeCalculo?                   @relation("SucesionDeEjecucion", fields: [reemplazaAId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reemplazadaPor EjecucionDeCalculo?                   @relation("SucesionDeEjecucion")
  entradas       EntradaDeCalculo[]
  referencias    ReferenciaDeCalculo[]

  @@index([evaluacionId])
  @@map("ejecucion_de_calculo")
}

/// T-06-74 — la referencia profesional adoptada (REG-06-207). Adoptar es una RELACIÓN: no modifica la corrida, no
/// borra las otras y no crea objetivo ni prescripción. Cambiar de referencia sucede a la anterior y deja historia.
model ReferenciaDeCalculo {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asesoradoId         String             @map("asesorado_id") @db.Uuid
  profesionalId       String             @map("profesional_id") @db.Uuid
  finalidad           FinalidadDeCalculo
  ejecucionId         String             @map("ejecucion_id") @db.Uuid
  predecesoraId       String?            @unique @map("predecesora_id") @db.Uuid
  /// Token de concurrencia de la referencia vigente (REG-06-207: sucede, no pisa).
  version             Int                @default(1)
  fundamento          String?
  procedencia         Json
  momentoDeOcurrencia DateTime           @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime           @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  asesorado   Identidad            @relation("ReferenciaDeCalculoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profesional Identidad            @relation("ReferenciaDeCalculoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ejecucion   EjecucionDeCalculo   @relation(fields: [ejecucionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  predecesora ReferenciaDeCalculo? @relation("SucesionDeReferencia", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sucesora    ReferenciaDeCalculo? @relation("SucesionDeReferencia")

  @@index([asesoradoId, profesionalId, finalidad])
  @@index([ejecucionId])
  @@map("referencia_de_calculo")
}

/// REG-06-159 e INV-06-170 — la dependencia es EXPLÍCITA: una fila por entrada efectiva. Nunca se infiere por
/// nombre de campo ni por posición.
model EntradaDeCalculo {
  ejecucionId String  @map("ejecucion_id") @db.Uuid
  medicionId  String  @map("medicion_id") @db.Uuid
  metrica     String
  valor       Decimal @db.Decimal(12, 4)
  unidad      String

  ejecucion EjecucionDeCalculo     @relation(fields: [ejecucionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  medicion  MedicionAntropometrica @relation(fields: [medicionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([ejecucionId, medicionId])
  @@index([medicionId])
  @@map("entrada_de_calculo")
}

/// Hechos del dominio, append-only y con secuencia total, como los de nutrición.
model EventoDeAntropometria {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secuencia           BigInt                      @unique @default(autoincrement())
  tipo                TipoDeEventoDeAntropometria
  evaluacionId        String?                     @map("evaluacion_id") @db.Uuid
  medicionId          String?                     @map("medicion_id") @db.Uuid
  actorId             String                      @map("actor_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime                    @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                    @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@index([evaluacionId])
  @@index([medicionId])
  @@map("evento_de_antropometria")
}

// ─── WP-06 · Circuito de entrenamiento (B-08, 06:4947-5786) ─────────────────────────────────────
//
// Reutiliza las taxonomías comunes sin crear vocabularios paralelos (REG-06-07, 06:431): el estado de la versión de
// plan es EstadoDeVersionDePlan, el resultado de la revisión es ResultadoDeRevision, la procedencia del catálogo es
// ProcedenciaDeCatalogo. Los dominios, en cambio, no se fusionan: cada uno tiene sus tablas.

/// REG-06-131: conjunto cerrado de tres. NO_REALIZADA registrada no es lo mismo que una sesión sin registro.
enum CondicionDeSesion {
  REALIZADA
  REALIZADA_CON_DESVIO
  NO_REALIZADA
}

/// REG-06-132: se conserva cuál granularidad se usó; no se descompone retrospectivamente.
enum GranularidadDeRegistro {
  SERIE
  EJERCICIO_O_SESION
}

enum TipoDeEventoDeEntrenamiento {
  EjercicioDeCatalogoCreado
  EvaluacionDeEntrenamientoRegistrada
  VersionDeObjetivoDeEntrenamientoEmitida
  BorradorDePlanDeEntrenamientoCreado
  BorradorDePlanDeEntrenamientoGuardado
  VersionDePlanDeEntrenamientoActivada
  BorradorDeEjecucionCreado
  BorradorDeEjecucionGuardado
  EjecucionRegistrada
  EjecucionCorregida
  RevisionDeEntrenamientoRegistrada
}

/// Catálogo propio de ejercicios (RF-037; REG-06-99 a 101). Un cambio de catálogo no reescribe sesiones ya
/// prescriptas: la instantánea congela nombre y versión al activar (REG-06-112).
model EjercicioDeCatalogo {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procedencia       ProcedenciaDeCatalogo
  creadoPorId       String?               @map("creado_por_id") @db.Uuid
  momentoDeRegistro DateTime              @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  creadoPor Identidad?           @relation("EjercicioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versiones VersionDeEjercicio[]

  @@map("ejercicio_de_catalogo")
}

model VersionDeEjercicio {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ejercicioId       String                   @map("ejercicio_id") @db.Uuid
  predecesoraId     String?                  @unique @map("predecesora_id") @db.Uuid
  nombre            String
  disponibilidad    DisponibilidadDeElemento @default(DISPONIBLE)
  procedencia       Json
  momentoDeRegistro DateTime                 @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  ejercicio   EjercicioDeCatalogo @relation(fields: [ejercicioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora VersionDeEjercicio? @relation("CadenaDeEjercicio", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora    VersionDeEjercicio? @relation("CadenaDeEjercicio")

  @@index([ejercicioId])
  @@map("version_de_ejercicio")
}

/// RF-036; REG-06-97. El contenido profesional no lo fija el 09 (09v10:202): JSON validado por allowlist (DL-080).
model EvaluacionDeEntrenamiento {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId       String   @map("profesional_id") @db.Uuid
  asesoradoId         String   @map("asesorado_id") @db.Uuid
  valoracion          Json
  referencias         Json
  notas               String?
  procedencia         Json
  momentoDeOcurrencia DateTime @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional Identidad                          @relation("EvaluacionDeEntrenamientoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado   Identidad                          @relation("EvaluacionDeEntrenamientoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  objetivos   VersionDeObjetivoDeEntrenamiento[]

  @@index([asesoradoId, profesionalId, momentoDeRegistro])
  @@map("evaluacion_de_entrenamiento")
}

/// RF-064; REG-06-98. La serie del objetivo; cada cambio es una versión nueva y la anterior queda reconstruible.
model ObjetivoDeEntrenamiento {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId     String   @map("profesional_id") @db.Uuid
  asesoradoId       String   @map("asesorado_id") @db.Uuid
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional Identidad                          @relation("ObjetivoDeEntrenamientoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado   Identidad                          @relation("ObjetivoDeEntrenamientoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versiones   VersionDeObjetivoDeEntrenamiento[]

  @@unique([profesionalId, asesoradoId])
  @@map("objetivo_de_entrenamiento")
}

model VersionDeObjetivoDeEntrenamiento {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objetivoId         String    @map("objetivo_id") @db.Uuid
  predecesoraId      String?   @unique @map("predecesora_id") @db.Uuid
  evaluacionId       String    @map("evaluacion_id") @db.Uuid
  vigenteDesde       DateTime  @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta       DateTime? @map("vigente_hasta") @db.Timestamptz(3)
  /// «El contenido concreto del objetivo no se fija en 09» (09v10:228).
  objetivo           Json
  fundamento         String
  /// Revisión CAMBIAR_OBJETIVO que la emitió, si la hay.
  revisionDeOrigenId String?   @map("revision_de_origen_id") @db.Uuid
  autorId            String    @map("autor_id") @db.Uuid
  procedencia        Json
  momentoDeRegistro  DateTime  @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  objetivoDeLaSerie ObjetivoDeEntrenamiento           @relation(fields: [objetivoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora       VersionDeObjetivoDeEntrenamiento? @relation("CadenaDeObjetivoDeEntrenamiento", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora          VersionDeObjetivoDeEntrenamiento? @relation("CadenaDeObjetivoDeEntrenamiento")
  evaluacion        EvaluacionDeEntrenamiento         @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeOrigen  RevisionDeEntrenamiento?          @relation("ObjetivoDeRevisionDeEntrenamiento", fields: [revisionDeOrigenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionesDePlan   VersionDePlanDeEntrenamiento[]

  @@index([objetivoId])
  @@map("version_de_objetivo_de_entrenamiento")
}

/// REG-06-102. El 09 **no separa** los borradores de plan en otra colección (09v10:238-245, 682): el borrador es la
/// misma versión en estado BORRADOR. Es la asimetría deliberada del contrato.
model PlanDeEntrenamiento {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId     String   @map("profesional_id") @db.Uuid
  asesoradoId       String   @map("asesorado_id") @db.Uuid
  versionEfectivaId String?  @unique @map("version_efectiva_id") @db.Uuid
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  profesional     Identidad                      @relation("PlanDeEntrenamientoDelProfesional", fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asesorado       Identidad                      @relation("PlanDeEntrenamientoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionEfectiva VersionDePlanDeEntrenamiento?  @relation("VersionEfectivaDeEntrenamiento", fields: [versionEfectivaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versiones       VersionDePlanDeEntrenamiento[] @relation("VersionesDelPlanDeEntrenamiento")

  @@unique([profesionalId, asesoradoId])
  @@map("plan_de_entrenamiento")
}

model VersionDePlanDeEntrenamiento {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String                @map("plan_id") @db.Uuid
  predecesoraId       String?               @unique @map("predecesora_id") @db.Uuid
  /// Dos estados, no tres: no existe VALIDADO. Validar es condición de ActivarVersion (06:4330).
  estado              EstadoDeVersionDePlan @default(BORRADOR)
  version             Int                   @default(1)
  versionDeObjetivoId String                @map("version_de_objetivo_id") @db.Uuid
  /// Plan → Bloque → Microciclo [0..N] → Sesión planificada → Prescripción, con identificadores estables (REG-06-111).
  contenido           Json
  proximaRevision     DateTime?             @map("proxima_revision") @db.Date
  /// Revisión AJUSTAR o SUSTITUIR que la creó, si la hay.
  revisionDeOrigenId  String?               @map("revision_de_origen_id") @db.Uuid
  autorId             String                @map("autor_id") @db.Uuid
  procedencia         Json
  momentoDeRegistro   DateTime              @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeActivacion DateTime?             @map("momento_de_activacion") @db.Timestamptz(3)

  plan                  PlanDeEntrenamiento                  @relation("VersionesDelPlanDeEntrenamiento", fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecesora           VersionDePlanDeEntrenamiento?        @relation("CadenaDePlanDeEntrenamiento", fields: [predecesoraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sucesora              VersionDePlanDeEntrenamiento?        @relation("CadenaDePlanDeEntrenamiento")
  versionDeObjetivo     VersionDeObjetivoDeEntrenamiento     @relation(fields: [versionDeObjetivoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionDeOrigen      RevisionDeEntrenamiento?             @relation("PlanDeRevisionDeEntrenamiento", fields: [revisionDeOrigenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instantanea           InstantaneaDePlanDeEntrenamiento?
  efectivaDe            PlanDeEntrenamiento?                 @relation("VersionEfectivaDeEntrenamiento")
  borradoresDeEjecucion BorradorDeEjecucionDeEntrenamiento[]
  ejecuciones           EjecucionDeEntrenamiento[]
  procesoAbierto        ProcesoOperativo?                    @relation("AperturaDeProcesoDeEntrenamiento")
  proximasRevisiones    ProximaRevision[]                    @relation("ProximaRevisionDePlanDeEntrenamiento")

  @@index([planId])
  @@map("version_de_plan_de_entrenamiento")
}

/// REG-06-112: la instantánea reconstruye orden y relaciones exactamente como se emitieron. La ejecución cuelga de
/// acá, nunca del catálogo ni del borrador actuales (REG-06-105; INV-06-121).
model InstantaneaDePlanDeEntrenamiento {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionDePlanId   String   @unique @map("version_de_plan_id") @db.Uuid
  contenido         Json
  huella            String
  momentoDeRegistro DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  versionDePlan VersionDePlanDeEntrenamiento @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("instantanea_de_plan_de_entrenamiento")
}

/// El borrador de ejecución es su **propia colección** en el 09 (09v10:924-1135), a diferencia del plan. Uno por
/// ocurrencia: (asesorado, versión activada, sesión planificada, fecha local), como en nutrición (DL-049, DL-077).
/// Una vez confirmado queda congelado: la vuelta de REGISTRADA a BORRADOR no existe (06:5221).
model BorradorDeEjecucionDeEntrenamiento {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asesoradoId            String                  @map("asesorado_id") @db.Uuid
  versionDePlanId        String                  @map("version_de_plan_id") @db.Uuid
  sesionPlanificadaId    String                  @map("sesion_planificada_id")
  fechaLocal             DateTime                @map("fecha_local") @db.Date
  zonaHoraria            String                  @map("zona_horaria")
  /// Nula al nacer: la granularidad se decide al editar (09v10:954).
  granularidad           GranularidadDeRegistro?
  condicion              CondicionDeSesion?
  motivo                 String?
  contenido              Json                    @default("{}")
  /// Instante declarado de la sesión, para registrar en diferido. Nulo si no se declaró: al confirmar se usa el
  /// comienzo del borrador solo si fue el mismo día local; BE no inventa la hora de una sesión pasada.
  momentoDeOcurrencia    DateTime?               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  version                Int                     @default(1)
  momentoDeRegistro      DateTime                @default(now()) @map("momento_de_registro") @db.Timestamptz(3)
  momentoDeActualizacion DateTime                @default(now()) @map("momento_de_actualizacion") @db.Timestamptz(3)

  asesorado     Identidad                    @relation("BorradorDeEjecucionDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDePlan VersionDePlanDeEntrenamiento @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ejecucion     EjecucionDeEntrenamiento?

  @@unique([asesoradoId, versionDePlanId, sesionPlanificadaId, fechaLocal])
  @@map("borrador_de_ejecucion_de_entrenamiento")
}

/// La ejecución registrada: colección propia, inmutable. REG-06-115 vive en la base: una sola por ocurrencia.
model EjecucionDeEntrenamiento {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asesoradoId         String                 @map("asesorado_id") @db.Uuid
  versionDePlanId     String                 @map("version_de_plan_id") @db.Uuid
  sesionPlanificadaId String                 @map("sesion_planificada_id")
  fechaLocal          DateTime               @map("fecha_local") @db.Date
  zonaHoraria         String                 @map("zona_horaria")
  borradorId          String                 @unique @map("borrador_id") @db.Uuid
  /// Nula si y solo si la sesión se registró NO_REALIZADA: sin entrenamiento no se usó ninguna granularidad, y
  /// exigir una sería registrar un hecho que no ocurrió (REG-06-132).
  granularidad        GranularidadDeRegistro?
  condicion           CondicionDeSesion
  motivo              String?
  contenido           Json
  procedencia         Json
  momentoDeOcurrencia DateTime               @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime               @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  asesorado     Identidad                              @relation("EjecucionDeEntrenamientoDelAsesorado", fields: [asesoradoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionDePlan VersionDePlanDeEntrenamiento           @relation(fields: [versionDePlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  borrador      BorradorDeEjecucionDeEntrenamiento     @relation(fields: [borradorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correcciones  CorreccionDeEjecucionDeEntrenamiento[]

  @@unique([asesoradoId, versionDePlanId, sesionPlanificadaId, fechaLocal])
  @@index([asesoradoId, fechaLocal])
  @@map("ejecucion_de_entrenamiento")
}

/// REG-06-116: la ejecución registrada no se edita; se corrige por el patrón B-06 (UC-I12). Se conserva la autoría
/// real: si corrige el profesional, el dato no se atribuye al asesorado (05:9209-9224).
model CorreccionDeEjecucionDeEntrenamiento {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ejecucionId        String   @map("ejecucion_id") @db.Uuid
  correccionPreviaId String?  @unique @map("correccion_previa_id") @db.Uuid
  autorId            String   @map("autor_id") @db.Uuid
  motivo             String
  contenido          Json
  procedencia        Json
  momentoDeRegistro  DateTime @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  ejecucion        EjecucionDeEntrenamiento              @relation(fields: [ejecucionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correccionPrevia CorreccionDeEjecucionDeEntrenamiento? @relation("SucesionDeCorreccionDeEjecucion", fields: [correccionPreviaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siguiente        CorreccionDeEjecucionDeEntrenamiento? @relation("SucesionDeCorreccionDeEjecucion")
  autor            Identidad                             @relation("CorreccionDeEjecucionDelAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ejecucionId])
  @@map("correccion_de_ejecucion_de_entrenamiento")
}

/// UC-P18; REG-06-141. Seis resultados, sin séptimo: la progresión mapea a AJUSTAR o SUSTITUIR (REG-06-117).
model RevisionDeEntrenamiento {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procesoId           String              @map("proceso_id") @db.Uuid
  periodoInicio       DateTime            @map("periodo_inicio") @db.Date
  periodoFin          DateTime            @map("periodo_fin") @db.Date
  zonaHoraria         String              @map("zona_horaria")
  evidencias          Json
  interpretacion      String
  resultado           ResultadoDeRevision
  fundamento          String
  proximaAccion       Json                @map("proxima_accion")
  autorId             String              @map("autor_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime?           @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime            @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  proceso            ProcesoOperativo                     @relation("RevisionDeEntrenamientoDelProceso", fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  aplicacion         AplicacionDeRevisionDeEntrenamiento?
  planesCreados      VersionDePlanDeEntrenamiento[]       @relation("PlanDeRevisionDeEntrenamiento")
  objetivosCreados   VersionDeObjetivoDeEntrenamiento[]   @relation("ObjetivoDeRevisionDeEntrenamiento")
  eventos            EventoDeProceso[]                    @relation("EventoDeRevisionDeEntrenamiento")
  proximasRevisiones ProximaRevision[]                    @relation("ProximaRevisionDeRevisionDeEntrenamiento")

  @@index([procesoId])
  @@map("revision_de_entrenamiento")
}

/// REG-06-75 y 77: la aplicación enlaza el ContinuidadOCierreAplicado de su revisión, y FINALIZAR ⇔ CIERRE_PROCESO.
model AplicacionDeRevisionDeEntrenamiento {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId                String           @unique @map("revision_id") @db.Uuid
  eventoId                  String           @unique @map("evento_id") @db.Uuid
  tipo                      TipoDeAplicacion
  estadoDeProcesoPosterior  EstadoDeProceso  @map("estado_de_proceso_posterior")
  versionDePlanCreadaId     String?          @map("version_de_plan_creada_id") @db.Uuid
  versionDeObjetivoCreadaId String?          @map("version_de_objetivo_creada_id") @db.Uuid
  momentoDeRegistro         DateTime         @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  revision RevisionDeEntrenamiento @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evento   EventoDeProceso         @relation("AplicacionDeEntrenamientoDelEvento", fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("aplicacion_de_revision_de_entrenamiento")
}

model EventoDeEntrenamiento {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secuencia           BigInt                      @unique @default(autoincrement())
  tipo                TipoDeEventoDeEntrenamiento
  profesionalId       String?                     @map("profesional_id") @db.Uuid
  asesoradoId         String?                     @map("asesorado_id") @db.Uuid
  recursoTipo         String                      @map("recurso_tipo")
  recursoId           String                      @map("recurso_id") @db.Uuid
  estadoPrevio        String?                     @map("estado_previo")
  estadoPosterior     String?                     @map("estado_posterior")
  actorId             String                      @map("actor_id") @db.Uuid
  procedencia         Json
  momentoDeOcurrencia DateTime?                   @map("momento_de_ocurrencia") @db.Timestamptz(3)
  momentoDeRegistro   DateTime                    @default(now()) @map("momento_de_registro") @db.Timestamptz(3)

  @@index([asesoradoId, momentoDeRegistro])
  @@index([recursoId])
  @@map("evento_de_entrenamiento")
}
